<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- ASP.NET Core shared framework: configuration, health checks now; Identity in Phase 2. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL Server provider for EF Core (hosting: SmarterASP.NET, Windows / IIS). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Patched version of a SqlClient dependency (the one it brings has known vulnerabilities). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- snake_case tables/columns: readable names, kept from the first schema. -->
    <PackageReference Include="EFCore.NamingConventions" />
    <!-- Identity stores (users, security stamp, lockout) on EF Core. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- Cookie / antiforgery keys stored in the database: a redeploy or a new server must not sign everybody out. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <!-- JWT for the REST API (future mobile app). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Readiness probe that checks the database connection. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- PDF documents (diagnostic reports, exports, later receipts). Community licence: free under 1 M$ revenue. -->
    <PackageReference Include="QuestPDF" />
    <!-- Migrations tooling (design time only, not shipped). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Seed\senegal-locations.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeneCare.Application\SeneCare.Application.csproj" />
  </ItemGroup>

</Project>
