<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>810afc0f-110e-461d-95d3-f0b8692bb0f8</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeneCare.Application\SeneCare.Application.csproj" />
    <ProjectReference Include="..\SeneCare.Infrastructure\SeneCare.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Service worker template, served by /sw.js with the current asset versions. -->
    <EmbeddedResource Include="Pwa/sw.js" LogicalName="SeneCare.Web.Pwa.sw.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json;Styles\**" />
  </ItemGroup>

  <!--
    Tailwind CSS: compiles Styles/app.css into wwwroot/css/app.css (minified) on every build
    when views or styles changed. Requires Node.js; skip with -p:SkipTailwind=true.
  -->
  <Target Name="TailwindInstall" BeforeTargets="TailwindBuild" Condition="'$(SkipTailwind)' != 'true' And !Exists('node_modules')">
    <Exec Command="npm ci" />
  </Target>

  <Target Name="TailwindBuild" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwind)' != 'true'" Inputs="@(Content -&gt; WithMetadataValue('Extension', '.cshtml'));Styles\app.css;package.json" Outputs="wwwroot\css\app.css">
    <Exec Command="npm run css:build" />
  </Target>

</Project>
