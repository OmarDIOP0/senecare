@model ChangePasswordViewModel
@{
    Layout = "Signup/_Shell";
    ViewData["Title"] = L["Password_Change_Title"];
    string? Error(string field) => ViewData.ModelState[field]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<p class="sc-eyebrow">@L["SignIn_Eyebrow"]</p>
<h1 class="mt-3 font-display text-2xl leading-tight font-bold tracking-[-0.02em] sm:text-[1.875rem]">@(Model.MustChange ? L["Password_Choose_Title"] : L["Password_Change_Title"])</h1>
<p class="mt-2 text-charbon-doux">@(Model.MustChange ? L["Password_Choose_Text"] : L["Password_Change_Text"])</p>

<form method="post" class="mt-8 grid gap-5" novalidate data-send-once>
    @if (!Model.MustChange)
    {
        <partial name="Ui/_PasswordInput" model='new PasswordInputModel(nameof(Model.CurrentPassword), L["Password_Current"].Value, Error(nameof(Model.CurrentPassword)))' />
    }
    <partial name="Ui/_PasswordInput" model='new PasswordInputModel(nameof(Model.NewPassword), L["Password_New"].Value, Error(nameof(Model.NewPassword)), NewPassword: true)' />
    <partial name="Ui/_PasswordInput" model='new PasswordInputModel(nameof(Model.ConfirmPassword), L["Password_Confirm"].Value)' />
    <button type="submit" class="sc-btn-primaire min-h-12 w-full text-base">@L["Password_Save"]</button>
</form>
@if (!Model.MustChange)
{
    <p class="mt-6"><a href="/compte" class="sc-lien">@L["Common_Back"]</a></p>
}
