@model SeneCare.Application.Users.UserProfileDto
@using Microsoft.AspNetCore.Authorization
@using SeneCare.Infrastructure.Identity
@inject IAuthorizationService Authorization
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "profil";
    ViewData["Title"] = L["Account_Title"];
    var canManageTeam = (await Authorization.AuthorizeAsync(User, Policies.OrganizationManager)).Succeeded;
}

<h1 class="text-2xl font-semibold tracking-tight">@L["Account_Title"]</h1>

<dl class="mt-4 space-y-2">
    <div><dt class="text-sm text-charbon-doux">@L["Account_Name"]</dt><dd class="font-semibold">@Model.FullName</dd></div>
    <div><dt class="text-sm text-charbon-doux">@L["Account_Phone"]</dt><dd class="font-semibold">+221 @Model.Phone</dd></div>
</dl>

<h2 class="mt-6 text-[15px] font-semibold">@L["Account_Memberships"]</h2>
<ul class="mt-2 space-y-2">
    @foreach (var membership in Model.Memberships)
    {
        <li class="rounded-lg border border-ligne bg-surface px-4 py-3">
            <span class="font-medium">@membership.AccountName</span>
            <span class="text-sm text-charbon-doux">· @L["Kind_" + membership.Kind] · @L["Role_" + membership.Role]</span>
        </li>
    }
</ul>

@if (canManageTeam)
{
    <p class="mt-4"><a href="/entreprise/equipe" class="sc-btn-secondaire">@L["Account_Team"]</a></p>
}

<div class="mt-8 grid gap-2 sm:grid-cols-2">
    <a href="/bienvenue?rejouer=true" class="sc-btn-secondaire">@L["Account_Replay"]</a>
    <form method="post" asp-controller="Space" asp-action="ReplayTour">
        <button type="submit" class="sc-btn-secondaire w-full">@L["Account_ReplayTour"]</button>
    </form>
</div>

<form method="post" asp-controller="Auth" asp-action="SignOutUser" class="mt-8" data-logout>
    <button type="submit" class="sc-btn-secondaire w-full">@L["Nav_SignOut"]</button>
</form>
