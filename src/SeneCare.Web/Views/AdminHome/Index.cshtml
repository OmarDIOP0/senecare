@model SeneCare.Application.Admin.AdminDashboard
@using System.Globalization
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "espace";
    ViewData["Title"] = L["Tab_Dashboard"];
    ViewData["Wide"] = true;
    var maxRevenue = Math.Max(1, Model.Revenue.Max(r => r.Amount.Amount));
    var finance = User.IsInRole("Finance") || User.IsInRole("SuperAdmin");
    var dispatch = User.IsInRole("Dispatcher") || User.IsInRole("SuperAdmin");
    string Month(int year, int month) => new DateTime(year, month, 1).ToString("MMM yy", CultureInfo.CurrentCulture);
}

<h1 class="sc-titre" data-tour="tableau-de-bord">@L["Tab_Dashboard"]</h1>

<section aria-label="@L["Biz_Figures"]" class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-ligne bg-ligne lg:grid-cols-5">
    <a href="@(dispatch ? "/admin/dispatch" : null)" class="bg-surface px-4 py-3 text-charbon no-underline hover:bg-sourdine hover:no-underline">
        <p class="text-[13px] text-charbon-doux">@L["Admin_Open"]</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">@Model.Open</p>
    </a>
    <a href="@(dispatch ? "/admin/dispatch" : null)" class="bg-surface px-4 py-3 text-charbon no-underline hover:bg-sourdine hover:no-underline">
        <p class="text-[13px] text-charbon-doux">@L["Admin_Late"]</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums @(Model.LateNow > 0 ? "text-rouge" : "")">@Model.LateNow</p>
    </a>
    <div class="bg-surface px-4 py-3">
        <p class="text-[13px] text-charbon-doux">@L["Admin_Sla"]</p>
        @if (Model.SlaRate is { } r)
        {
            <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums @(r < 90 ? "text-rouge" : "")">@r %</p>
            <p class="mt-0.5 text-xs text-charbon-doux">@L["Admin_SlaWindow", Model.SlaMeasured]</p>
        }
        else
        {
            <p class="mt-2 text-[13px] text-charbon-doux">@L["Admin_NotEnoughData"]</p>
        }
    </div>
    <a href="@(finance ? "/admin/paiements" : null)" class="bg-surface px-4 py-3 text-charbon no-underline hover:bg-sourdine hover:no-underline">
        <p class="text-[13px] text-charbon-doux">@L["Admin_Unpaid"]</p>
        <p class="mt-1 text-2xl font-semibold tracking-tight"><sc-amount value="@Model.Unpaid.Amount" /></p>
        <p class="mt-0.5 text-xs text-charbon-doux">@L["Admin_UnpaidInvoices", Model.UnpaidInvoices, Model.PendingPayments]</p>
    </a>
    <div class="col-span-2 bg-surface px-4 py-3 lg:col-span-1">
        <p class="text-[13px] text-charbon-doux">@L["Admin_Satisfaction"]</p>
        @if (Model.AverageRating is { } avg)
        {
            <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">@avg.ToString("0.0", CultureInfo.CurrentCulture) / 5</p>
            <p class="mt-0.5 text-xs text-charbon-doux">@L["Admin_Ratings", Model.Ratings, Model.Disputes]</p>
        }
        else
        {
            <p class="mt-2 text-[13px] text-charbon-doux">@L["Admin_NotEnoughData"]</p>
        }
    </div>
</section>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
    <section class="min-w-0 sc-carte lg:col-span-2" aria-labelledby="ca-titre">
        <h2 id="ca-titre" class="sc-sous-titre">@L["Admin_Revenue"]</h2>
        @if (Model.Revenue.All(r => r.Amount.Amount == 0))
        {
            <p class="sc-texte-doux mt-2">@L["Admin_NoRevenue"]</p>
        }
        else
        {
        <ol class="mt-4 flex h-48 items-end gap-3" aria-label="@L["Admin_Revenue"]">
            @foreach (var month in Model.Revenue)
            {
                var height = (int)Math.Round(100.0 * month.Amount.Amount / maxRevenue);
                <li class="flex h-full flex-1 flex-col items-center justify-end gap-1">
                    <span class="text-xs font-medium tabular-nums">@(month.Amount.Amount >= 1_000_000 ? (month.Amount.Amount / 1_000_000.0).ToString("0.#", CultureInfo.CurrentCulture) + " M" : (month.Amount.Amount / 1000).ToString("N0", CultureInfo.CurrentCulture) + " k")</span>
                    <span class="w-full rounded-t-md bg-ocre" style="height: @(Math.Max(height, 2))%" title="@Formatting.Fcfa(month.Amount)"></span>
                    <span class="text-xs text-charbon-doux">@Month(month.Year, month.Month)</span>
                </li>
            }
        </ol>
        }
    </section>

    <section class="sc-carte" aria-labelledby="urgence-titre">
        <h2 id="urgence-titre" class="sc-sous-titre">@L["Admin_ByUrgency"]</h2>
        <partial name="_Bars" model='Model.ByUrgency.Select(c => (L["Urgency_" + c.Key].Value, c.Value)).ToList()' />
        <h2 class="sc-sous-titre mt-6">@L["Admin_ByStatus"]</h2>
        <partial name="_Bars" model='Model.ByStatus.Select(c => (L["Status_" + c.Key].Value, c.Value)).ToList()' />
    </section>

    <section class="sc-carte" aria-labelledby="metier-titre">
        <h2 id="metier-titre" class="sc-sous-titre">@L["Admin_ByDomain"]</h2>
        <partial name="_Bars" model='Model.ByDomain.Select(c => (L["Domain_" + c.Key].Value, c.Value)).ToList()' />
    </section>

    <section class="sc-carte" aria-labelledby="zone-titre">
        <h2 id="zone-titre" class="sc-sous-titre">@L["Admin_ByZone"]</h2>
        <partial name="_Bars" model='Model.ByCommune.Select(c => (c.Key, c.Value)).ToList()' />
    </section>

    <section class="sc-carte" aria-labelledby="quartiers-titre">
        <h2 id="quartiers-titre" class="sc-sous-titre">@L["Admin_Neighborhoods"]</h2>
        @if (Model.Neighborhoods.Count == 0)
        {
            <p class="sc-texte-doux mt-2">@L["Admin_NotEnoughData"]</p>
        }
        <ul class="mt-3 grid gap-3">
            @foreach (var n in Model.Neighborhoods)
            {
                var pct = Math.Min(100, (int)Math.Round(100.0 * n.Members / Math.Max(1, n.Threshold)));
                <li>
                    <p class="flex justify-between text-sm"><span class="font-medium">@n.Neighborhood <span class="font-normal text-charbon-doux">· @n.Commune</span></span><span class="tabular-nums">@n.Members / @n.Threshold</span></p>
                    <span class="mt-1 block h-2 rounded-full bg-ligne"><span class="block h-2 rounded-full bg-baobab" style="width: @pct%"></span></span>
                </li>
            }
        </ul>
    </section>
</div>
