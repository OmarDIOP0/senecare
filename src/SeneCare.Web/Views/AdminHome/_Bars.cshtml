@model List<(string Label, int Value)>
@{
    var max = Model.Count == 0 ? 1 : Math.Max(1, Model.Max(m => m.Value));
}
@if (Model.Count == 0)
{
    <p class="sc-texte-doux mt-2">—</p>
}
<ul class="mt-3 grid gap-2">
    @foreach (var (label, value) in Model)
    {
        <li class="grid grid-cols-[minmax(0,9rem)_1fr_auto] items-center gap-2 text-sm">
            <span class="truncate">@label</span>
            <span class="h-2.5 rounded-full bg-ligne"><span class="block h-2.5 rounded-full bg-atlantique" style="width: @(Math.Max(4, 100 * value / max))%"></span></span>
            <span class="font-bold tabular-nums">@value</span>
        </li>
    }
</ul>
