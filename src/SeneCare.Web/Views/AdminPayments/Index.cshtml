@model IReadOnlyList<SeneCare.Application.Payments.PendingPayment>
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "paiements";
    ViewData["Title"] = L["AdminPay_Title"];
    var waveLink = ViewData["WaveLink"] as string;
    var unpaid = ViewData["Unpaid"] as IReadOnlyList<SeneCare.Application.Payments.UnpaidInvoice> ?? [];
}

<p class="sc-eyebrow">@L["AdminPay_Eyebrow"]</p>
<h1 class="sc-titre mt-2">@L["AdminPay_Title"]</h1>
<p class="mt-2 text-charbon-doux">@L["AdminPay_Intro"]</p>

@* ---- Payment methods: Wave today (merchant link set here), mobile money next ---- *@
<section class="mt-8" aria-labelledby="moyens-titre">
    <h2 id="moyens-titre" class="sc-sous-titre">@L["AdminPay_Methods"]</h2>
    <div class="mt-4 grid gap-4 lg:grid-cols-[1.4fr_1fr]">
        <div class="overflow-hidden rounded-3xl border border-ligne bg-surface shadow-carte">
            <div class="flex items-center justify-between gap-3 border-b border-ligne bg-[#1dc8ff]/10 px-6 py-4">
                <div class="flex items-center gap-3">
                    <img src="~/images/wave-logo.png" alt="Wave" width="48" height="48" class="size-12 rounded-xl" />
                    <div>
                        <p class="text-lg font-bold">Wave</p>
                        <p class="text-sm text-charbon-doux">@L["AdminPay_WaveText"]</p>
                    </div>
                </div>
                @if (string.IsNullOrWhiteSpace(waveLink))
                {
                    <span class="sc-badge bg-soleil-clair text-soleil"><span class="size-1.5 rounded-full bg-soleil"></span>@L["AdminPay_NotSet"]</span>
                }
                else
                {
                    <span class="sc-badge bg-baobab-clair text-baobab"><span class="size-1.5 rounded-full bg-baobab"></span>@L["AdminPay_Active"]</span>
                }
            </div>
            <form method="post" asp-action="SetWaveLink" class="grid gap-3 p-6">
                <label class="sc-label-mono" for="link">@L["AdminPay_LinkLabel"]</label>
                <input id="link" name="link" type="url" inputmode="url" class="sc-input font-mono text-sm" value="@waveLink" placeholder="https://pay.wave.com/m/M_sn_.../c/sn/?amount={montant}" aria-describedby="link-aide" />
                <p id="link-aide" class="sc-aide">@L["AdminPay_LinkHint"]</p>
                <button type="submit" class="sc-btn-primaire justify-self-start">@L["AdminPay_LinkSave"]</button>
            </form>
        </div>
        <ul class="grid content-start gap-3">
            @foreach (var (name, tint) in new[] { ("Orange Money", "bg-[#ff7900]"), ("Free Money", "bg-[#cd1719]") })
            {
                <li class="flex items-center justify-between gap-3 rounded-2xl border border-dashed border-ligne bg-surface/60 px-5 py-4">
                    <span class="flex items-center gap-3"><span class="grid size-10 place-items-center rounded-xl @tint font-mono text-xs font-bold text-white">@name[..1]</span><span class="font-semibold">@name</span></span>
                    <span class="sc-badge bg-sourdine text-charbon-doux">@L["AdminPay_Soon"]</span>
                </li>
            }
            <li class="flex items-start gap-3 rounded-2xl bg-sourdine px-5 py-4 text-sm text-charbon-doux"><sc-icon name="info" class="mt-0.5 size-5" />@L["AdminPay_CashHint"]</li>
        </ul>
    </div>
</section>

<section class="mt-10" aria-labelledby="attente-titre">
    <h2 id="attente-titre" class="sc-sous-titre">@L["AdminPay_Pending", Model.Count]</h2>
    @if (Model.Count == 0)
    {
        <p class="sc-texte-doux mt-2">@L["AdminPay_None"]</p>
    }
    <ul class="mt-3 grid gap-3">
        @foreach (var p in Model)
        {
            <li class="sc-carte">
                <div class="flex flex-wrap items-start justify-between gap-2">
                    <div>
                        <p class="font-medium">@p.CustomerName <span class="font-normal text-charbon-doux">· +221 @p.CustomerPhone</span></p>
                        <p class="text-sm text-charbon-doux">@p.AccountName · @L["AdminPay_DeclaredOn", Formatting.ShortDateTime(p.DeclaredAt)]</p>
                    </div>
                    <sc-amount value="@p.Amount.Amount" class="font-display text-xl" />
                </div>
                <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
                    <dt class="text-charbon-doux">@L["AdminPay_Invoice"]</dt><dd class="font-medium">@p.InvoiceNumber</dd>
                    <dt class="text-charbon-doux">@L["AdminPay_Channel"]</dt><dd>@p.Channel</dd>
                    <dt class="text-charbon-doux">@L["AdminPay_CustomerRef"]</dt><dd class="font-mono">@(p.CustomerReference ?? "—")</dd>
                </dl>
                <p class="sc-aide mt-2">@L["AdminPay_CheckHint", p.InvoiceNumber]</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <form method="post" asp-action="Verify" asp-route-id="@p.PaymentId">
                        <button type="submit" class="sc-btn bg-baobab text-white hover:brightness-110"><sc-icon name="check" />@L["AdminPay_Verify"]</button>
                    </form>
                    <button type="button" class="sc-btn-danger" data-sheet-open="refus-@p.PaymentId">@L["AdminPay_Reject"]</button>
                </div>
                <sc-sheet id="refus-@p.PaymentId" title="@L["AdminPay_Reject"]">
                    <form method="post" asp-action="Reject" asp-route-id="@p.PaymentId" class="grid gap-3">
                        <label class="sc-label" for="motif-@p.PaymentId">@L["AdminPay_RejectReason"]</label>
                        <textarea id="motif-@p.PaymentId" name="reason" rows="2" class="sc-input py-2" required placeholder="@L["AdminPay_RejectReason_Placeholder"]"></textarea>
                        <button type="submit" class="sc-btn-danger">@L["AdminPay_Reject"]</button>
                    </form>
                </sc-sheet>
            </li>
        }
    </ul>
</section>

<section class="mt-10" aria-labelledby="impayes-titre">
    <h2 id="impayes-titre" class="sc-sous-titre">@L["AdminPay_Unpaid", unpaid.Count]</h2>
    <p class="sc-texte-doux mt-1">@L["AdminPay_Unpaid_Hint"]</p>
    <ul class="mt-3 divide-y divide-ligne rounded-lg border border-ligne bg-surface">
        @foreach (var invoice in unpaid)
        {
            <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                <div>
                    <p class="font-medium">@invoice.Number · @invoice.AccountName</p>
                    <p class="text-sm">@L["Subscription_DueOn", Formatting.ShortDate(new DateTimeOffset(invoice.DueDate.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero))] · @L["InvoiceStatus_" + invoice.Status]</p>
                </div>
                <div class="flex items-center gap-3">
                    <sc-amount value="@invoice.Due.Amount" class="font-medium" />
                    <button type="button" class="sc-btn-secondaire min-h-10 text-sm" data-sheet-open="encaisser-@invoice.InvoiceId">@L["AdminPay_Record"]</button>
                </div>
                <sc-sheet id="encaisser-@invoice.InvoiceId" title="@L["AdminPay_Record"]">
                    <form method="post" action="/admin/paiements/factures/@invoice.InvoiceId/encaisser" class="grid gap-3">
                        @Html.AntiForgeryToken()
                        <p>@invoice.Number · <sc-amount value="@invoice.Due.Amount" class="font-medium" /></p>
                        <fieldset class="grid grid-cols-2 gap-2">
                            <legend class="sc-label">@L["AdminPay_Channel"]</legend>
                            <label class="sc-choix"><input type="radio" name="channel" value="Cash" checked />@L["Channel_Cash"]</label>
                            <label class="sc-choix"><input type="radio" name="channel" value="BankTransfer" />@L["Channel_BankTransfer"]</label>
                        </fieldset>
                        <label class="sc-label" for="note-@invoice.InvoiceId">@L["AdminPay_Note"]</label>
                        <input id="note-@invoice.InvoiceId" name="note" class="sc-input" required maxlength="500" placeholder="@L["AdminPay_Note_Placeholder"]" />
                        <button type="submit" class="sc-btn bg-baobab text-white hover:brightness-110">@L["AdminPay_Record"]</button>
                    </form>
                </sc-sheet>
            </li>
        }
    </ul>
</section>
