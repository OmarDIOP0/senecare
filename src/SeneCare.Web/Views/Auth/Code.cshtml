@model CodeViewModel
@using SeneCare.Domain.Users
@{
    Layout = "Signup/_Shell";
    ViewData["Title"] = L["Code_Title"];
    var channelLabel = Model.Channel == OtpChannel.WhatsApp ? L["SignIn_ChannelWhatsApp"] : L["SignIn_ChannelSms"];
}

@if (Model.Signup)
{
    @* Still step 2 of « Créer mon compte ». *@
    <partial name="Signup/_StepBars" model="2" />
    <p class="sc-eyebrow mt-8">@L["Register_StepOf", 2, 5] — @L["Register_StepPhone"]</p>
}
else
{
    <p class="sc-eyebrow">@L["SignIn_Eyebrow"]</p>
}
<h1 class="mt-3 font-display text-2xl leading-tight font-bold tracking-[-0.02em] sm:text-[1.875rem]">@L["Code_Heading"]</h1>
<p class="mt-2 text-charbon-doux">@L["Code_SentTo", Model.FormattedPhone, channelLabel]</p>

@if (TempData["flash.error"] is string flash)
{
    <p class="sc-error mt-4" role="alert">@flash</p>
}

<form method="post" asp-action="Code" class="mt-8 grid gap-5" novalidate data-send-once>
    <div data-otp>
        <label class="sc-label" for="Code">@L["Code_Label"]</label>
        <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" pattern="[0-9 ]*"
               class="sc-input min-h-14 text-center font-display text-2xl tracking-[0.4em] tabular-nums" aria-describedby="code-error" required autofocus data-otp-value />
        @* With JavaScript: six boxes that fill the field above (typing, paste, WhatsApp / SMS autofill). *@
        <div class="mt-1.5 grid grid-cols-6 gap-2 sm:gap-3" data-otp-boxes hidden>
            @for (var i = 1; i <= 6; i++)
            {
                <input type="text" inputmode="numeric" autocomplete="@(i == 1 ? "one-time-code" : "off")" aria-label="@L["Code_Digit", i]"
                       class="sc-input mt-0 aspect-square h-auto min-h-0 w-full p-0 text-center font-display text-2xl tabular-nums sm:text-3xl" data-otp-box />
            }
        </div>
        <span id="code-error" asp-validation-for="Code" class="sc-error" role="alert"></span>
        @if (Model.DevelopmentCode is { } devCode)
        {
            @* Development only: Program.cs refuses Otp:ShowCodeOnPage in any other environment. *@
            <p class="mt-3 flex flex-wrap items-center gap-2 rounded-md border border-dashed border-ligne bg-sourdine px-3 py-2 text-sm text-charbon-doux">
                <sc-icon name="wrench" class="size-4" />@L["Code_DevelopmentHint"]
                <span class="font-mono text-base font-bold tracking-[0.3em] text-charbon">@devCode</span>
            </p>
        }
    </div>
    <button type="submit" class="sc-btn-primaire min-h-12 w-full text-base">@(Model.Signup ? L["Register_Next"] : L["Code_Submit"])<sc-icon name="arrow-right" class="size-5" /></button>
</form>

<div class="mt-4 flex flex-wrap gap-2">
    <form method="post" asp-action="Resend">
        <input type="hidden" name="channel" value="@Model.Channel" />
        <button type="submit" class="sc-btn-discret">@L["Code_Resend"]</button>
    </form>
    <a href="@(Model.Signup ? "/inscription?numero" : "/connexion")" class="sc-btn-discret">@L["Code_ChangeNumber"]</a>
</div>
