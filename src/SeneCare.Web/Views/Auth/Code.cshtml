@model CodeViewModel
@using SeneCare.Domain.Users
@{
    ViewData["Title"] = L["Code_Title"];
    var channelLabel = Model.Channel == OtpChannel.WhatsApp ? L["SignIn_ChannelWhatsApp"] : L["SignIn_ChannelSms"];
}

<h1 class="text-2xl font-bold text-atlantique">@L["Code_Heading"]</h1>
<p class="mt-2">@L["Code_SentTo", Model.FormattedPhone, channelLabel]</p>

@if (TempData["flash.error"] is string flash)
{
    <p class="sc-error" role="alert">@flash</p>
}

<form method="post" asp-action="Code" class="mt-6 space-y-5" novalidate>
    <div>
        <label class="sc-label" for="Code">@L["Code_Label"]</label>
        <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="7" pattern="[0-9 ]*"
               class="sc-input text-center text-2xl tracking-[0.4em]" aria-describedby="code-error" required autofocus />
        <span id="code-error" asp-validation-for="Code" class="sc-error" role="alert"></span>
    </div>
    <button type="submit" class="sc-btn">@L["Code_Submit"]</button>
</form>

<div class="mt-6 flex flex-wrap gap-3">
    <form method="post" asp-action="Resend">
        <input type="hidden" name="channel" value="@Model.Channel" />
        <button type="submit" class="sc-btn-secondary">@L["Code_Resend"]</button>
    </form>
    <a asp-action="SignIn" class="sc-btn-secondary">@L["Code_ChangeNumber"]</a>
</div>
