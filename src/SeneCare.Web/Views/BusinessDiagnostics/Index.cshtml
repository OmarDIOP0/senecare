@model IReadOnlyList<SeneCare.Application.Business.DiagnosticSlot>
@using SeneCare.Domain.Diagnostics
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "espace";
    ViewData["Title"] = L["Space_Diagnostics"];
    var canSimulate = ViewData["CanSimulate"] is true && AppNavigation.IsBusinessManager(User);
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
}

<h1 class="sc-titre">@L["Space_Diagnostics"]</h1>
<p class="mt-2 text-charbon-doux">@L["Diagnostic_Intro"]</p>

@if (Model.Count == 0)
{
    <div class="mt-6">
        <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Diagnostic_None_Title"], L["Diagnostic_None_Text"], EmptyIllustration.Tools)' />
    </div>
}

<ol class="mt-6 grid gap-3">
    @foreach (var d in Model)
    {
        var done = d.Status is DiagnosticStatus.Submitted or DiagnosticStatus.Validated;
        <li class="sc-carte relative flex items-center gap-4">
            <span class="grid size-12 shrink-0 place-items-center rounded-md @(done ? "bg-baobab-clair text-baobab" : "bg-indigo-clair text-indigo")">
                <sc-icon name="@(done ? "circle-check" : "calendar")" class="size-6" />
            </span>
            <div class="min-w-0 flex-1">
                <p class="text-xs font-medium text-charbon-doux">@L["Diagnostic_PeriodShort", Day(d.Period.Start), Day(d.Period.End)]</p>
                <h2 class="font-semibold">
                    @if (done)
                    {
                        <a href="/entreprise/diagnostics/@d.Id" class="text-charbon no-underline after:absolute after:inset-0 hover:underline">@L["Diagnostic_Of", Formatting.ShortDate(d.ScheduledFor)]</a>
                    }
                    else
                    {
                        @L["Diagnostic_PlannedOn", Formatting.ShortDateTime(d.ScheduledFor)]
                    }
                </h2>
                <p class="mt-1 flex flex-wrap gap-2">
                    <span class="sc-badge bg-sourdine text-charbon-doux">@L["DiagnosticStatus_" + d.Status]</span>
                    @if (done)
                    {
                        <span class="sc-badge @(d.Anomalies > 0 ? "bg-laterite-clair text-laterite" : "bg-baobab-clair text-baobab")">@L["Diagnostic_AnomalyCount", d.Anomalies]</span>
                    }
                </p>
            </div>
            @if (done)
            {
                <sc-icon name="chevron-right" class="text-charbon-doux" />
            }
        </li>
    }
</ol>

@if (canSimulate && Model.Any(d => d.Status == DiagnosticStatus.Planned))
{
    <form method="post" asp-action="Simulate" class="mt-6">
        <button type="submit" class="sc-btn-secondaire min-h-10 text-sm">Réaliser le diagnostic (simulation, développement)</button>
    </form>
}
