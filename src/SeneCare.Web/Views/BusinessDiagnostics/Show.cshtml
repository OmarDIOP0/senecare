@model SeneCare.Application.Business.DiagnosticDetail
@using SeneCare.Domain.Diagnostics
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "espace";
    ViewData["Wide"] = true;
    var title = L["Diagnostic_ReportTitle", BusinessDocuments.Quarter(Model.Slot.Period.Start), Model.Slot.Period.Start.Year];
    ViewData["Title"] = title;
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
}

<a href="/entreprise/diagnostics" class="text-sm font-medium">← @L["Space_Diagnostics"]</a>
<div class="mt-2 flex flex-wrap items-start justify-between gap-3">
    <div>
        <h1 class="sc-titre">@title</h1>
        <p class="mt-1 text-charbon-doux">@Model.AccountName · @L["Diagnostic_PeriodShort", Day(Model.Slot.Period.Start), Day(Model.Slot.Period.End)]</p>
    </div>
    @if (Model.IsReportAvailable)
    {
        <a href="/entreprise/diagnostics/@Model.Slot.Id/rapport.pdf" class="sc-btn-secondaire" download><sc-icon name="receipt" />@L["Diagnostic_DownloadPdf"]</a>
    }
</div>

<dl class="sc-carte mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div><dt class="sc-texte-doux">@L["Diagnostic_Date"]</dt><dd class="font-medium">@Formatting.ShortDate(Model.Slot.ScheduledFor)</dd></div>
    <div><dt class="sc-texte-doux">@L["Diagnostic_Status"]</dt><dd class="font-medium">@L["DiagnosticStatus_" + Model.Slot.Status]</dd></div>
    <div><dt class="sc-texte-doux">@L["Diagnostic_Technician"]</dt><dd class="font-medium">@(Model.TechnicianName ?? "—")</dd></div>
    <div><dt class="sc-texte-doux">@L["Diagnostic_Anomalies"]</dt><dd class="text-2xl font-semibold @(Model.Slot.Anomalies > 0 ? "text-rouge" : "")">@Model.Slot.Anomalies</dd></div>
</dl>

@if (!string.IsNullOrWhiteSpace(Model.Recommendations))
{
    <aside class="sc-carte mt-4" aria-labelledby="reco-titre">
        <h2 id="reco-titre" class="sc-surtitre">@L["Diagnostic_Recommendations"]</h2>
        <p class="mt-1 whitespace-pre-line">@Model.Recommendations</p>
    </aside>
}

<div class="mt-6 grid gap-6 lg:grid-cols-2">
    @foreach (var site in Model.Sites)
    {
        <section class="sc-carte" aria-label="@(site.Name ?? L["Diagnostic_General"].Value)">
            <h2 class="sc-sous-titre flex items-center gap-2"><sc-icon name="building-2" class="text-atlantique" />@(site.Name ?? L["Diagnostic_General"].Value)</h2>
            <ul class="mt-3 divide-y divide-ligne">
                @foreach (var point in site.Points)
                {
                    var anomaly = point.Result == ControlPointResult.Anomaly;
                    <li class="py-3">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="text-xs font-medium text-charbon-doux">@L["Domain_" + point.Domain]</p>
                                <p class="font-medium">@point.Label</p>
                                @if (point.Comment is { } comment)
                                {
                                    <p class="text-sm">@comment</p>
                                }
                            </div>
                            <span class="sc-badge shrink-0 @(anomaly ? "bg-rouge-clair text-rouge" : point.Result == ControlPointResult.Ok ? "bg-baobab-clair text-baobab" : "bg-sourdine text-charbon-doux")">@L["ControlPoint_" + point.Result]</span>
                        </div>
                        @if (point.PhotoIds.Count > 0)
                        {
                            <div class="mt-2 flex gap-2 overflow-x-auto">
                                @foreach (var photo in point.PhotoIds)
                                {
                                    <img src="/fichiers/@photo" alt="" loading="lazy" decoding="async" class="size-20 rounded-md object-cover" />
                                }
                            </div>
                        }
                        @if (anomaly)
                        {
                            @if (point.ConvertedRequestId is { } requestId)
                            {
                                <a href="/interventions/@requestId" class="mt-2 inline-flex items-center gap-1 text-sm font-medium"><sc-icon name="clipboard-list" class="size-4" />@L["Diagnostic_SeeRequest"]</a>
                            }
                            else if (Model.CanConvert)
                            {
                                <form method="post" asp-action="Convert" asp-route-id="@Model.Slot.Id" asp-route-pointId="@point.Id" class="mt-2">
                                    <button type="submit" class="sc-btn-secondaire min-h-10 text-sm"><sc-icon name="wrench" />@L["Diagnostic_Convert"]</button>
                                </form>
                            }
                        }
                    </li>
                }
            </ul>
        </section>
    }
</div>
