@model SeneCare.Application.Admin.CustomerFile
@using SeneCare.Domain.Accounts
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "gestion";
    ViewData["Wide"] = true;
    var s = Model.Summary;
    ViewData["Title"] = s.Name;
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
}

<a href="/admin/clients" class="inline-flex min-h-12 items-center font-medium">← @L["Admin_Customers"]</a>
<div class="flex flex-wrap items-start justify-between gap-3">
    <h1 class="sc-titre">@s.Name</h1>
    @if (User.IsInRole("SuperAdmin") || User.IsInRole("Support"))
    {
        @if (s.SuspendedAt is null)
        {
            <button type="button" class="sc-btn-secondaire text-rouge" data-sheet-open="suspendre">
                <sc-icon name="ban" class="size-4" />@L["Admin_Suspend"]
            </button>
            <sc-sheet id="suspendre" title="@L["Admin_Suspend"]">
                <form method="post" action="/admin/clients/@s.AccountId/suspendre" class="grid gap-3">
                    @Html.AntiForgeryToken()
                    <p>@L["Admin_Suspend_Text", s.Name]</p>
                    <label class="sc-choix"><input type="checkbox" name="confirm" value="true" required />@L["Admin_Suspend_Confirm"]</label>
                    <button type="submit" class="sc-btn bg-rouge text-sur-accent">@L["Admin_Suspend"]</button>
                </form>
            </sc-sheet>
        }
        else
        {
            <form method="post" action="/admin/clients/@s.AccountId/reactiver">
                @Html.AntiForgeryToken()
                <button type="submit" class="sc-btn-primaire">@L["Admin_Reactivate"]</button>
            </form>
        }
    }
</div>
@if (s.SuspendedAt is { } suspendedAt)
{
    <p class="mt-3 rounded-2xl border border-rouge/40 bg-rouge-clair px-4 py-3 text-rouge" role="status">@L["Admin_SuspendedBanner", Formatting.ShortDate(suspendedAt)]</p>
}
<p class="mt-1">@(s.Kind == AccountKind.Business ? L["Register_ProfileBusiness"] : L["Register_ProfileHousehold"]) · @L["Admin_Since"] @Formatting.ShortDate(s.CreatedAt)@(Model.Ninea is { } ninea ? " · NINEA " + ninea : "")</p>
<p class="mt-1">@L["Admin_RequestsCount", Model.Requests, Model.OpenRequests]</p>

@if (TempData["reset.password"] is string temporary && TempData["reset.phone"] is string resetPhone)
{
    @* Shown once: the admin gives it to the person, who must change it at the next sign-in. *@
    var digits = new string(resetPhone.Where(char.IsAsciiDigit).ToArray());
    var message = L["Admin_ResetPassword_Message", temporary].Value;
    <section class="mt-6 rounded-2xl border border-ambre bg-ocre-clair p-5" role="status">
        <h2 class="font-semibold">@L["Admin_ResetPassword_Done", TempData["reset.name"] as string ?? resetPhone]</h2>
        <p class="mt-2 text-sm text-charbon-doux">@L["Admin_ResetPassword_Give"]</p>
        <p class="mt-3 inline-flex items-center gap-3 rounded-md bg-surface px-4 py-2 font-mono text-xl font-bold tracking-[0.15em] select-all">@temporary</p>
        <p class="mt-4"><a href="https://wa.me/221@(digits)?text=@Uri.EscapeDataString(message)" class="sc-btn-whatsapp" target="_blank" rel="noopener"><sc-icon name="message-circle" />@L["Admin_ResetPassword_SendWhatsApp"]</a></p>
    </section>
}

<div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="sc-carte" aria-labelledby="membres-titre">
        <h2 id="membres-titre" class="sc-sous-titre">@L["Team_Members"]</h2>
        <ul class="mt-2 divide-y divide-ligne">
            @foreach (var m in Model.Members)
            {
                <li class="flex flex-wrap justify-between gap-2 py-2">
                    <span><span class="font-medium">@(m.Name ?? "—")</span> · +221 @m.Phone</span>
                    <span class="flex items-center gap-2">
                        <span class="sc-badge bg-sourdine text-charbon-doux">@L["Role_" + m.Role]</span>
                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Support"))
                        {
                            <button type="button" class="text-sm font-medium text-atlantique" data-sheet-open="mdp-@m.UserId">@L["Admin_ResetPassword"]</button>
                            <sc-sheet id="mdp-@m.UserId" title="@L["Admin_ResetPassword"]">
                                <form method="post" action="/admin/clients/@s.AccountId/membres/@m.UserId/mot-de-passe" class="grid gap-3">
                                    @Html.AntiForgeryToken()
                                    <p>@L["Admin_ResetPassword_Confirm", m.Name ?? m.Phone]</p>
                                    <button type="submit" class="sc-btn-primaire">@L["Admin_ResetPassword"]</button>
                                </form>
                            </sc-sheet>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <a href="/admin/donnees/@m.UserId/export.json" class="text-sm font-medium" download>@L["Admin_ExportData"]</a>
                            <button type="button" class="text-sm font-medium text-laterite" data-sheet-open="effacer-@m.UserId">@L["Admin_Erase"]</button>
                            <sc-sheet id="effacer-@m.UserId" title="@L["Admin_Erase"]">
                                <form method="post" action="/admin/donnees/@m.UserId/effacer" class="grid gap-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="/admin/clients/@s.AccountId" />
                                    <p>@L["Admin_Erase_Text", m.Name ?? m.Phone]</p>
                                    <label class="sc-choix"><input type="checkbox" name="confirm" value="true" required />@L["Admin_Erase_Confirm"]</label>
                                    <button type="submit" class="sc-btn bg-laterite text-sur-accent">@L["Admin_Erase"]</button>
                                </form>
                            </sc-sheet>
                        }
                    </span>
                </li>
            }
        </ul>
    </section>

    <section class="sc-carte" aria-labelledby="sites-titre">
        <h2 id="sites-titre" class="sc-sous-titre">@L["Biz_Sites"]</h2>
        <ul class="mt-2 divide-y divide-ligne">
            @foreach (var site in Model.Sites)
            {
                <li class="py-2"><span class="font-medium">@site.Name</span> · @L["PropertyKind_" + site.Kind]<span class="block text-sm">@site.Place</span></li>
            }
        </ul>
    </section>

    <section class="sc-carte" aria-labelledby="abonnements-titre">
        <h2 id="abonnements-titre" class="sc-sous-titre">@L["Space_Subscription"]</h2>
        <ul class="mt-2 divide-y divide-ligne">
            @foreach (var sub in Model.Subscriptions)
            {
                <li class="flex flex-wrap justify-between gap-2 py-2">
                    <span><span class="font-medium">@sub.Plan</span> · <sc-amount value="@sub.MonthlyPrice.Amount" /> @L["Offer_PerMonth"]@if (sub.NextDueDate is { } due) { <span class="block text-sm">@L["Subscription_NextDue", Day(due)]</span> }</span>
                    <span class="sc-badge bg-sourdine text-charbon-doux">@L["SubscriptionStatus_" + sub.Status]</span>
                </li>
            }
        </ul>
    </section>

    <section class="sc-carte" aria-labelledby="factures-titre">
        <h2 id="factures-titre" class="sc-sous-titre">@L["Subscription_Invoices"]</h2>
        <ul class="mt-2 divide-y divide-ligne">
            @foreach (var invoice in Model.Invoices)
            {
                <li class="flex flex-wrap justify-between gap-2 py-2">
                    <span><span class="font-medium">@invoice.Number</span><span class="block text-sm">@L["Subscription_DueOn", Day(invoice.DueDate)]</span></span>
                    <span class="text-right"><sc-amount value="@invoice.Total.Amount" class="font-medium" /><span class="block text-sm">@L["InvoiceStatus_" + invoice.Status]</span></span>
                </li>
            }
        </ul>
    </section>
</div>
