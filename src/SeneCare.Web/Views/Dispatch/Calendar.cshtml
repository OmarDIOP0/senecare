@model IReadOnlyList<SeneCare.Application.Admin.CalendarEntry>
@using System.Globalization
@using SeneCare.Domain.Common
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "dispatch";
    ViewData["Title"] = L["Dispatch_Calendar"];
    ViewData["Wide"] = true;
    var start = (DateOnly)ViewData["WeekStart"]!;
    var days = Enumerable.Range(0, 7).Select(i => start.AddDays(i)).ToList();
    string Iso(DateOnly d) => d.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}

<h1 class="sc-titre">@L["Tab_Dispatch"]</h1>
<partial name="_DispatchNav" model='"calendrier"' />

<div class="mt-4 flex items-center justify-between gap-2">
    <a href="?semaine=@Iso(start.AddDays(-7))" class="sc-btn-secondaire min-h-10 text-sm">← @L["Dispatch_PrevWeek"]</a>
    <p class="font-bold">@L["Dispatch_Week", Formatting.ShortDate(new DateTimeOffset(start.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero))]</p>
    <a href="?semaine=@Iso(start.AddDays(7))" class="sc-btn-secondaire min-h-10 text-sm">@L["Dispatch_NextWeek"] →</a>
</div>

<div class="mt-4 grid gap-3 md:grid-cols-7">
    @foreach (var day in days)
    {
        var entries = Model.Where(e => DateOnly.FromDateTime(e.Start.UtcDateTime) == day).ToList();
        <section class="rounded-lg border border-ligne bg-surface p-2" aria-label="@day.ToString("dddd d MMMM", CultureInfo.CurrentCulture)">
            <h2 class="text-sm font-bold capitalize">@day.ToString("ddd d", CultureInfo.CurrentCulture)</h2>
            <ul class="mt-2 grid gap-2">
                @foreach (var e in entries)
                {
                    <li class="rounded-md border-l-4 bg-sable p-2 text-xs @(e.Urgency == Urgency.Critical ? "border-laterite" : e.Urgency == Urgency.High ? "border-soleil" : "border-atlantique")">
                        <a href="/admin/dispatch/@e.RequestId" class="font-bold">@Formatting.Time(e.Start)–@Formatting.Time(e.End)</a>
                        <span class="block">@L["Domain_" + e.Domain] · @e.Site</span>
                        <span class="block text-charbon-doux">@(e.TechnicianName ?? L["Dispatch_Unassigned"].Value)</span>
                    </li>
                }
            </ul>
        </section>
    }
</div>
