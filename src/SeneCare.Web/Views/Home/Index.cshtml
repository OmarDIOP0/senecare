@model SeneCare.Application.Public.PublicHome
@using SeneCare.Domain.Common
@{
    ViewData["Title"] = L["Home_Title"];
    ViewData["FullWidth"] = true;
    ViewData["PhotoCredits"] = true;
    var steps = new[] { ("Home_Step1_Title", "Home_Step1_Text"), ("Home_Step2_Title", "Home_Step2_Text"), ("Home_Step3_Title", "Home_Step3_Text"), ("Home_Step4_Title", "Home_Step4_Text") };
    // Reviews: published ones first (consent given); the sample ones only while there are none (development).
    var realReviews = Model.Reviews;
    var showSampleReviews = realReviews.Count == 0 && Site.Visible(Site.Reviews);
    var advice = Model.Advice.Count > 0
        ? Model.Advice
        : [
            new SeneCare.Application.Public.PublicAdvice(L["Space_Advice_PreRain_Title"].Value, L["Space_Advice_PreRain_Text"].Value, ServiceDomain.Waterproofing),
            new SeneCare.Application.Public.PublicAdvice(L["Space_Advice_Rain_Title"].Value, L["Space_Advice_Rain_Text"].Value, ServiceDomain.Plumbing),
        ];
}

@* ---- Hero: descriptive title, quick request form, a technician at work ---- *@
<section class="border-b border-ligne bg-sourdine">
    <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-10 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-14 lg:px-6 lg:py-16">
        <div>
            <h1 class="text-3xl leading-tight font-bold text-atlantique sm:text-4xl lg:text-[2.75rem]">@L["Home_Hero_Title"]</h1>
            <p class="mt-4 max-w-xl text-lg text-charbon-doux">@L["Home_Hero_Text"]</p>
            <ul class="mt-5 grid gap-2 text-[15px] sm:grid-cols-2">
                <li class="flex items-start gap-2"><sc-icon name="check" class="mt-0.5 size-5 text-laterite" />@L["Home_Hero_Point1"]</li>
                <li class="flex items-start gap-2"><sc-icon name="check" class="mt-0.5 size-5 text-laterite" />@L["Home_Hero_Point2"]</li>
                <li class="flex items-start gap-2"><sc-icon name="check" class="mt-0.5 size-5 text-laterite" />@L["Home_Hero_Point3"]</li>
                <li class="flex items-start gap-2"><sc-icon name="check" class="mt-0.5 size-5 text-laterite" />@L["Home_Hero_Point4"]</li>
            </ul>

            <form method="get" action="/demander" class="mt-8 rounded-lg border border-ligne bg-surface p-5 shadow-sm sm:p-6" aria-labelledby="demande-rapide">
                <h2 id="demande-rapide" class="text-lg">@L["Home_QuickForm_Title"]</h2>
                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="sc-label" for="qf-metier">@L["Home_QuickForm_Trade"]</label>
                        <select id="qf-metier" name="metier" class="sc-input">
                            <option value="">@L["Home_QuickForm_TradeAny"]</option>
                            @foreach (var trade in Site.Trades)
                            {
                                <option value="@trade.Domain">@trade.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="sc-label" for="qf-quartier">@L["Home_QuickForm_Area"]</label>
                        <input id="qf-quartier" name="quartier" class="sc-input" list="qf-quartiers" placeholder="@L["Home_QuickForm_AreaPlaceholder"]" autocomplete="address-level3" />
                        <datalist id="qf-quartiers">
                            @foreach (var hood in Site.Neighborhoods)
                            {
                                <option value="@hood"></option>
                            }
                        </datalist>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="sc-label" for="qf-telephone">@L["SignIn_PhoneLabel"]</label>
                        <div class="mt-1.5 flex">
                            <span class="inline-flex items-center rounded-l-md border border-r-0 border-ligne bg-sourdine px-3 text-[15px] text-charbon-doux">+221</span>
                            <input id="qf-telephone" name="telephone" type="tel" inputmode="tel" autocomplete="tel-national" class="sc-input mt-0 rounded-l-none" placeholder="77 123 45 67" aria-describedby="qf-telephone-aide" />
                        </div>
                        <p id="qf-telephone-aide" class="sc-aide">@L["Home_QuickForm_PhoneHelp"]</p>
                    </div>
                </div>
                <button type="submit" class="sc-btn-primaire mt-5 w-full sm:w-auto sm:px-6">@L["Site_RequestJob"]<sc-icon name="arrow-right" class="size-4" /></button>
            </form>
        </div>

        <partial name="Site/_Photo" model='new PhotoModel("/images/hero-technicien.webp", L["Home_Photo_Electrician_Alt"].Value, "hidden aspect-[4/5] w-full rounded-lg lg:block", 1200, 900, "wrench", Eager: true)' />
    </div>
</section>

@* ---- Trades, each with its photo ---- *@
<section id="metiers" class="mx-auto w-full max-w-7xl scroll-mt-24 px-4 pt-16 lg:px-6" aria-labelledby="metiers-titre">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h2 id="metiers-titre" class="sc-section-titre">@L["Home_Trades_Title"]</h2>
            <p class="mt-2 max-w-2xl text-[15px] text-charbon-doux">@L["Home_Trades_Text"]</p>
        </div>
        <a href="/metiers" class="sc-lien">@L["Site_AllTrades"]</a>
    </div>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
        @foreach (var trade in Site.Trades)
        {
            <li>
                <a href="/metiers/@trade.Slug" class="group grid h-full grid-cols-[6.5rem_1fr] overflow-hidden rounded-lg border border-ligne bg-surface text-charbon no-underline shadow-xs transition-shadow hover:no-underline hover:shadow-sm sm:flex sm:flex-col">
                    <partial name="Site/_Photo" model='new PhotoModel(trade.Image, trade.Name, "h-full w-full sm:aspect-[4/3] sm:h-auto", Icon: Formatting.Icon(trade.Domain))' />
                    <span class="flex flex-1 flex-col p-4">
                        <span class="flex items-center gap-2 text-lg font-bold"><sc-icon name="@Formatting.Icon(trade.Domain)" class="size-5 text-laterite" />@trade.Name</span>
                        <span class="mt-1.5 flex-1 text-[15px] text-charbon-doux">@trade.Summary</span>
                        @if (Site.Visible(trade))
                        {
                            <span class="mt-3 text-sm font-semibold">@trade.StartingPrice</span>
                        }
                        <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-laterite group-hover:underline">@L["Site_SeeTrade"]<sc-icon name="arrow-right" class="size-4" /></span>
                    </span>
                </a>
            </li>
        }
        <li>
            <a href="/demander" class="flex h-full flex-col justify-between rounded-lg border border-dashed border-charbon/25 bg-sourdine p-5 text-charbon no-underline hover:no-underline">
                <span>
                    <span class="block text-lg font-bold">@L["Home_Trades_Unsure_Title"]</span>
                    <span class="mt-2 block text-[15px] text-charbon-doux">@L["Home_Trades_Unsure_Text"]</span>
                </span>
                <span class="sc-btn-primaire mt-5 self-start">@L["Site_RequestJob"]</span>
            </a>
        </li>
    </ul>
</section>

@* ---- How it works ---- *@
<section class="mt-16 bg-sourdine py-16" aria-labelledby="etapes-titre">
    <div class="mx-auto w-full max-w-7xl px-4 lg:px-6">
        <h2 id="etapes-titre" class="sc-section-titre">@L["Home_Steps_Title"]</h2>
        <ol class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
            @foreach (var (index, (title, text)) in steps.Index())
            {
                <li class="rounded-lg border border-ligne bg-surface p-5 shadow-xs">
                    <span class="grid size-9 place-items-center rounded-full bg-laterite text-base font-bold text-sur-accent">@(index + 1)</span>
                    <h3 class="mt-4 text-base">@L[title]</h3>
                    <p class="mt-1.5 text-[15px] text-charbon-doux">@L[text]</p>
                </li>
            }
        </ol>
    </div>
</section>

@* ---- Technicians (sample content until replaced) ---- *@
@if (Site.Visible(Site.Technicians))
{
    <section class="mx-auto w-full max-w-7xl px-4 pt-16 lg:px-6" aria-labelledby="techniciens-titre">
        <div class="flex flex-wrap items-center gap-3">
            <h2 id="techniciens-titre" class="sc-section-titre">@L["Home_Techs_Title"]</h2>
            <partial name="Site/_SampleTag" model="Site.Technicians.Sample" />
        </div>
        <p class="mt-2 max-w-2xl text-[15px] text-charbon-doux">@L["Home_Techs_Text"]</p>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var tech in Site.Technicians.Items)
            {
                <li class="flex flex-col rounded-lg border border-ligne bg-surface p-5 shadow-xs">
                    <div class="flex items-center gap-3">
                        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-atlantique-clair text-lg font-bold text-atlantique" aria-hidden="true">@tech.FirstName[..1]</span>
                        <div>
                            <p class="font-bold">@tech.FirstName</p>
                            <p class="text-sm text-charbon-doux">@tech.Trade · @L["Home_Techs_Years", tech.Years]</p>
                        </div>
                    </div>
                    <p class="mt-4 text-[15px]">« @tech.Quote »</p>
                </li>
            }
        </ul>
    </section>
}

@* ---- A real job, in detail (sample until replaced) ---- *@
@if (Site.Visible(Site.ExampleJob))
{
    var job = Site.ExampleJob;
    <section class="mx-auto w-full max-w-7xl px-4 pt-16 lg:px-6" aria-labelledby="exemple-titre">
        <div class="grid overflow-hidden rounded-lg border border-ligne bg-surface shadow-xs lg:grid-cols-[1fr_1.3fr]">
            <partial name="Site/_Photo" model='new PhotoModel("/images/metier-electricite.webp", L["Home_Example_PhotoAlt"].Value, "aspect-[4/3] h-full w-full lg:aspect-auto", Icon: "zap")' />
            <div class="p-6 sm:p-8">
                <div class="flex flex-wrap items-center gap-3">
                    <h2 id="exemple-titre" class="sc-section-titre">@L["Home_Example_Title"]</h2>
                    <partial name="Site/_SampleTag" model="job.Sample" />
                </div>
                <p class="mt-2 text-sm font-semibold text-charbon-doux">@job.Trade · @job.Neighborhood</p>
                <dl class="mt-5 grid gap-4 text-[15px]">
                    <div><dt class="font-semibold">@L["Home_Example_Problem"]</dt><dd class="mt-1 text-charbon-doux">@job.Problem</dd></div>
                    <div><dt class="font-semibold">@L["Home_Example_Work"]</dt><dd class="mt-1 text-charbon-doux">@job.Work</dd></div>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div><dt class="font-semibold">@L["Home_Example_Duration"]</dt><dd class="mt-1 text-charbon-doux">@job.Duration</dd></div>
                        <div><dt class="font-semibold">@L["Home_Example_Price"]</dt><dd class="mt-1 text-charbon-doux">@job.Price</dd></div>
                    </div>
                </dl>
            </div>
        </div>
    </section>
}

@* ---- Reviews: published ones (consent), else samples in development ---- *@
@if (realReviews.Count > 0 || showSampleReviews)
{
    <section class="mt-16 bg-sourdine py-16" aria-labelledby="avis-titre">
        <div class="mx-auto w-full max-w-7xl px-4 lg:px-6">
            <div class="flex flex-wrap items-center gap-3">
                <h2 id="avis-titre" class="sc-section-titre">@L["Home_Reviews_Title"]</h2>
                <partial name="Site/_SampleTag" model="showSampleReviews" />
            </div>
            <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                @if (realReviews.Count > 0)
                {
                    @foreach (var review in realReviews)
                    {
                        <li><partial name="Site/_Review" model='new ReviewCardModel(review.Author, review.Commune, review.GivenAt, review.Score, L["Domain_" + review.Domain].Value, review.Comment)' /></li>
                    }
                }
                else
                {
                    @foreach (var review in Site.Reviews.Items)
                    {
                        <li><partial name="Site/_Review" model='new ReviewCardModel(review.Author, review.Neighborhood, new DateTimeOffset(review.Date.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero), review.Rating, review.Trade, review.Text)' /></li>
                    }
                }
            </ul>
            <p class="mt-4 text-sm text-charbon-doux">@L["Home_Reviews_Note"]</p>
        </div>
    </section>
}

@* ---- Key figures: real ones when there is enough activity, samples in development ---- *@
@if (Model.Figures.HasEnough || Site.Visible(Site.Figures))
{
    <section class="mx-auto w-full max-w-7xl px-4 pt-16 lg:px-6" aria-labelledby="chiffres-titre">
        <div class="flex flex-wrap items-center gap-3">
            <h2 id="chiffres-titre" class="sc-section-titre">@L["Home_Figures_Title"]</h2>
            <partial name="Site/_SampleTag" model="!Model.Figures.HasEnough" />
        </div>
        <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-ligne bg-ligne lg:grid-cols-4">
            @if (Model.Figures.HasEnough)
            {
                <div class="flex flex-col-reverse bg-surface p-5"><dt class="mt-1 text-[15px] text-charbon-doux">@L["Home_Figures_Done"]</dt><dd class="text-3xl font-bold text-atlantique tabular-nums">@Model.Figures.CompletedInterventions.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)</dd></div>
                <div class="flex flex-col-reverse bg-surface p-5"><dt class="mt-1 text-[15px] text-charbon-doux">@L["Home_Figures_Rating", Model.Figures.Ratings]</dt><dd class="text-3xl font-bold text-atlantique tabular-nums">@Model.Figures.AverageRating!.Value.ToString("0.0", System.Globalization.CultureInfo.CurrentCulture) / 5</dd></div>
                <div class="flex flex-col-reverse bg-surface p-5"><dt class="mt-1 text-[15px] text-charbon-doux">@L["Home_Figures_Neighborhoods"]</dt><dd class="text-3xl font-bold text-atlantique tabular-nums">@Model.Figures.Neighborhoods</dd></div>
                <div class="flex flex-col-reverse bg-surface p-5"><dt class="mt-1 text-[15px] text-charbon-doux">@L["Home_Commit_Hood"]</dt><dd class="text-3xl font-bold text-atlantique tabular-nums">@Model.NeighborhoodThreshold</dd></div>
            }
            else
            {
                @foreach (var figure in Site.Figures.Items)
                {
                    <div class="flex flex-col-reverse bg-surface p-5"><dt class="mt-1 text-[15px] text-charbon-doux">@figure.Label</dt><dd class="text-3xl font-bold text-atlantique">@figure.Value</dd></div>
                }
            }
        </dl>
    </section>
}

@* ---- Advice ---- *@
<section id="conseils" class="mx-auto w-full max-w-7xl scroll-mt-24 px-4 pt-16 lg:px-6" aria-labelledby="conseils-titre">
    <h2 id="conseils-titre" class="sc-section-titre">@L["Home_Advice_Title"]</h2>
    <ul class="mt-8 grid gap-5 @(advice.Count >= 3 ? "md:grid-cols-3" : "md:grid-cols-2")">
        @foreach (var item in advice)
        {
            <li class="rounded-lg border border-ligne bg-surface p-5 shadow-xs">
                @if (item.Domain is { } domain)
                {
                    <p class="flex items-center gap-1.5 text-sm font-semibold text-laterite"><sc-icon name="@Formatting.Icon(domain)" class="size-4" />@L["Domain_" + domain]</p>
                }
                <h3 class="mt-2 text-base">@item.Title</h3>
                <p class="mt-1.5 text-[15px] text-charbon-doux">@item.Body</p>
            </li>
        }
    </ul>
</section>

@* ---- FAQ ---- *@
@if (Site.Visible(Site.Faq))
{
    <section class="mx-auto w-full max-w-4xl px-4 pt-16 lg:px-6" aria-labelledby="faq-titre">
        <div class="flex flex-wrap items-center gap-3">
            <h2 id="faq-titre" class="sc-section-titre">@L["Site_Faq"]</h2>
            <partial name="Site/_SampleTag" model="Site.Faq.Sample" />
        </div>
        <div class="mt-6 divide-y divide-ligne rounded-lg border border-ligne bg-surface shadow-xs">
            @foreach (var item in Site.Faq.Items.Take(6))
            {
                <details class="group px-5 py-4">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
                        @item.Question<sc-icon name="chevron-down" class="size-5 shrink-0 text-charbon-doux transition-transform group-open:rotate-180" />
                    </summary>
                    <p class="mt-3 text-[15px] text-charbon-doux">@item.Answer</p>
                </details>
            }
        </div>
        <a href="/faq" class="sc-lien mt-4 inline-block">@L["Site_FaqAll"]</a>
    </section>
}
