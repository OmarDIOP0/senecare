@model IReadOnlyList<SeneCare.Application.Requests.RequestSummary>
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "interventions";
    ViewData["Title"] = L["Requests_Title"];
    ViewData["Wide"] = true;
    var groups = new[]
    {
        (Title: L["Requests_Open"].Value, Items: Model.Where(r => r.IsOpen).ToList(), Id: "demandes-ouvertes"),
        (Title: L["Requests_Closed"].Value, Items: Model.Where(r => !r.IsOpen).ToList(), Id: "demandes-terminees"),
    };
}

<partial name="Ui/_PageHeader" model='new PageHeaderModel(L["Requests_Title"].Value, L["Requests_Description"].Value, Model.Count > 0 ? L["Tab_Report"].Value : null, "/signaler")' />

@if (Model.Count == 0)
{
    <div class="mt-6">
        <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Space_Client_Empty_Title"], L["Space_Client_Empty_Text"], EmptyIllustration.Tools, L["Tab_Report"], "/signaler")' />
    </div>
}

@foreach (var group in groups.Where(g => g.Items.Count > 0))
{
    <section class="mt-8" aria-labelledby="@group.Id">
        <h2 id="@group.Id" class="sc-sous-titre">@group.Title <span class="font-normal text-charbon-doux tabular-nums">@group.Items.Count</span></h2>
        <div class="mt-3 hidden overflow-x-auto rounded-lg border border-ligne bg-surface md:block">
            <table class="sc-table">
                <thead>
                    <tr>
                        <th scope="col" data-sort>@L["Export_Col_Number"]</th>
                        <th scope="col" data-sort>@L["Dispatch_Col_Request"]</th>
                        <th scope="col" data-sort>@L["Export_Col_Site"]</th>
                        <th scope="col">@L["Export_Col_Urgency"]</th>
                        <th scope="col">@L["Export_Col_Status"]</th>
                        <th scope="col" data-sort>@L["Export_Col_Date"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in group.Items)
                    {
                        <tr>
                            <td class="text-charbon-doux">@r.Number</td>
                            <td><a href="/interventions/@r.Id" class="font-medium text-charbon">@r.Title</a><span class="block text-xs text-charbon-doux">@L["Domain_" + r.Domain]@(r.Technician is { } tech ? " · " + tech.Name : "")</span></td>
                            <td>@r.PropertyName</td>
                            <td><sc-urgency value="@r.Urgency" /></td>
                            <td><sc-status value="@r.Status" /></td>
                            <td class="text-charbon-doux" data-value="@r.CreatedAt.ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@Formatting.ShortDate(r.AppointmentAt ?? r.CreatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3 grid gap-2 md:hidden">
            @foreach (var r in group.Items)
            {
                <partial name="Ui/_InterventionCard" model='new InterventionCardModel(r.Number, r.Domain, r.Title, r.Status, r.Urgency, "/interventions/" + r.Id, r.AppointmentAt, r.Technician?.Name, r.IsOpen ? r.Technician?.PhoneE164 : null)' />
            }
        </div>
    </section>
}
