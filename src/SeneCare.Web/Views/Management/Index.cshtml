@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "gestion";
    ViewData["Title"] = L["Tab_Management"];
    ViewData["Wide"] = true;
    var super_ = User.IsInRole("SuperAdmin");
    var dispatch = super_ || User.IsInRole("Dispatcher");
    var finance = super_ || User.IsInRole("Finance");
    var cards = new List<(string Url, string Icon, string Title, string Text)>
    {
        ("/admin/clients", "users", L["Admin_Customers"].Value, L["Admin_Customers_Text"].Value),
    };
    if (dispatch) cards.Add(("/admin/techniciens", "wrench", L["Admin_Technicians"].Value, L["Admin_Technicians_Text"].Value));
    if (dispatch) cards.Add(("/admin/quartiers", "sprout", L["Admin_Neighborhoods_Title"].Value, L["Admin_Neighborhoods_Text"].Value));
    cards.Add(("/admin/conseils", "info", L["Admin_Advice"].Value, L["Admin_Advice_Text"].Value));
    cards.Add(("/admin/avis", "star", L["Management_Reviews"].Value, L["Management_Reviews_Text"].Value));
    if (finance) cards.Add(("/admin/paiements", "wallet", L["Tab_Payments"].Value, L["Admin_Payments_Text"].Value));
    if (super_)
    {
        cards.Add(("/admin/offres", "receipt", L["Admin_Plans"].Value, L["Admin_Plans_Text"].Value));
        cards.Add(("/admin/referentiel", "map-pin", L["Admin_Geography"].Value, L["Admin_Geography_Text"].Value));
        cards.Add(("/admin/parametres", "list-checks", L["Admin_Settings"].Value, L["Admin_Settings_Text"].Value));
        cards.Add(("/admin/journal", "history", L["Admin_Journal"].Value, L["Admin_Journal_Text"].Value));
    }
}

<h1 class="sc-titre">@L["Tab_Management"]</h1>
<ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var (url, icon, title, text) in cards)
    {
        <li>
            <a href="@url" class="sc-carte flex h-full items-start gap-4 text-charbon no-underline">
                <span class="grid size-9 shrink-0 place-items-center rounded-md bg-sourdine text-charbon-doux"><sc-icon name="@icon" class="size-6" /></span>
                <span><span class="block font-medium">@title</span><span class="sc-texte-doux">@text</span></span>
            </a>
        </li>
    }
</ul>
