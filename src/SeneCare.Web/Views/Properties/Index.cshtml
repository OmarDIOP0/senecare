@model IReadOnlyList<SeneCare.Application.Properties.PropertySummary>
@{
    Layout = "_AppLayout";
    var isBusiness = AppNavigation.IsBusiness(User);
    var canAdd = !isBusiness || AppNavigation.IsBusinessManager(User);
    var title = isBusiness ? L["Sites_Title"] : L["Properties_Title"];
    ViewData["NavActive"] = isBusiness ? "sites" : "logements";
    ViewData["Title"] = title;
}

<div class="flex items-center justify-between gap-3">
    <h1 class="sc-titre">@title</h1>
    @if (Model.Count > 0 && canAdd)
    {
        <a href="/logements/nouveau" class="sc-btn-secondaire"><sc-icon name="plus" />@(isBusiness ? L["Site_Add_Short"] : L["Property_Add_Short"])</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="mt-6">
        @if (isBusiness)
        {
            <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Sites_Empty_Title"], L["Sites_Empty_Text"], EmptyIllustration.House, canAdd ? L["Site_Add"].Value : null, canAdd ? "/logements/nouveau" : null)' />
        }
        else
        {
            <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Space_NoProperty_Title"], L["Space_NoProperty_Text"], EmptyIllustration.House, L["Property_Add"], "/logements/nouveau")' />
        }
    </div>
}

<ul class="mt-6 grid gap-4 sm:grid-cols-2">
    @foreach (var home in Model)
    {
        <li class="sc-carte relative overflow-hidden p-0">
            @if (home.PhotoId is { } photo)
            {
                <img src="/fichiers/@photo" alt="" loading="lazy" decoding="async" class="h-36 w-full object-cover" />
            }
            else
            {
                <div class="sc-motif sc-motif-wax h-20 text-laterite/20" aria-hidden="true"></div>
            }
            <div class="p-4">
                <p class="text-xs font-bold text-charbon-doux">@L["PropertyKind_" + home.Kind]</p>
                <h2 class="font-display text-lg font-bold">
                    <a href="/logements/@home.Id" class="text-charbon no-underline after:absolute after:inset-0">@home.Name</a>
                </h2>
                <p class="mt-1 flex items-center gap-1 text-sm"><sc-icon name="map-pin" class="size-4 text-laterite" />@home.Neighborhood, @home.Commune</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    @if (home.SubscriptionStatus is { } status)
                    {
                        <span class="sc-badge @(status == SeneCare.Domain.Billing.SubscriptionStatus.Active ? "bg-baobab-clair text-baobab" : "bg-soleil-clair text-charbon")">@L["SubscriptionStatus_" + status]</span>
                    }
                    @if (home.OpenRequests > 0)
                    {
                        <span class="sc-badge bg-atlantique-clair text-atlantique">@L["Properties_OpenRequests", home.OpenRequests]</span>
                    }
                </div>
            </div>
        </li>
    }
</ul>
