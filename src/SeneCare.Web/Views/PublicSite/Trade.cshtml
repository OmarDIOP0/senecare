@model Trade
@{
    var home = (SeneCare.Application.Public.PublicHome)ViewData["Home"]!;
    ViewData["Title"] = L["Site_Trade_PageTitle", Model.Name];
    ViewData["FullWidth"] = true;
    ViewData["PhotoCredits"] = true;
    // Reviews about this trade: published ones, else the sample ones (development only).
    var published = home.Reviews.Where(r => r.Domain == Model.Domain).ToList();
    var samples = published.Count == 0 && Site.Visible(Site.Reviews)
        ? Site.Reviews.Items.Where(r => r.Trade == Model.Name).ToList()
        : [];
    var others = Site.Trades.Where(t => t.Slug != Model.Slug).ToList();
}

<section class="border-b border-ligne bg-sourdine">
    <div class="mx-auto grid w-full max-w-7xl gap-8 px-4 py-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-14 lg:px-6 lg:py-14">
        <div>
            <nav aria-label="@L["Site_Breadcrumb"]" class="text-sm text-charbon-doux">
                <a href="/" class="text-charbon-doux">@L["Home_Title"]</a> <span aria-hidden="true">›</span>
                <a href="/metiers" class="text-charbon-doux">@L["Public_Nav_Trades"]</a> <span aria-hidden="true">›</span>
                <span>@Model.Name</span>
            </nav>
            <h1 class="mt-3 text-3xl leading-tight font-bold text-atlantique sm:text-4xl lg:text-[2.625rem]">@L["Site_Trade_Heading", Model.Name]</h1>
            <p class="mt-4 max-w-2xl text-lg text-charbon-doux">@Model.Intro</p>
            @if (Site.Visible(Model))
            {
                <dl class="mt-6 grid gap-3 sm:grid-cols-2">
                    <div class="rounded-lg border border-ligne bg-surface p-4"><dt class="flex items-center gap-1.5 text-sm text-charbon-doux"><sc-icon name="timer" class="size-4 text-laterite" />@L["Site_Trade_Delay"]</dt><dd class="mt-1 font-semibold">@Model.Delay</dd></div>
                    <div class="rounded-lg border border-ligne bg-surface p-4"><dt class="flex items-center gap-1.5 text-sm text-charbon-doux"><sc-icon name="wallet" class="size-4 text-laterite" />@L["Site_Trade_Price"]</dt><dd class="mt-1 font-semibold">@Model.StartingPrice</dd></div>
                </dl>
            }
            <form method="get" action="/demander" class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-end">
                <input type="hidden" name="metier" value="@Model.Domain" />
                <div class="flex-1">
                    <label class="sc-label" for="t-telephone">@L["SignIn_PhoneLabel"]</label>
                    <div class="mt-1.5 flex">
                        <span class="inline-flex items-center rounded-l-md border border-r-0 border-ligne bg-surface px-3 text-[15px] text-charbon-doux">+221</span>
                        <input id="t-telephone" name="telephone" type="tel" inputmode="numeric" maxlength="17" data-phone autocomplete="tel-national" class="sc-input mt-0 rounded-l-none" placeholder="77 123 45 67" />
                    </div>
                </div>
                <button type="submit" class="sc-btn-primaire min-h-12 px-6">@L["Site_RequestJob"]</button>
            </form>
        </div>
        <partial name="Site/_TradeArt" model='new TradeArtModel(Model.Domain, Model.Name, "aspect-[4/3] w-full !rounded-3xl", Large: true)' />
    </div>
</section>

<section class="mx-auto w-full max-w-7xl px-4 pt-14 lg:px-6" aria-labelledby="prestations-titre">
    <h2 id="prestations-titre" class="sc-section-titre">@L["Site_Trade_WhatWeDo"]</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var example in Model.Examples)
        {
            <li class="flex items-center gap-3 rounded-lg border border-ligne bg-surface p-4 shadow-xs">
                <span class="grid size-9 shrink-0 place-items-center rounded-md bg-laterite-clair text-laterite"><sc-icon name="check" class="size-5" /></span>
                <span class="font-semibold">@example</span>
            </li>
        }
    </ul>
    <p class="mt-4 text-[15px] text-charbon-doux">@L["Site_Trade_Other"] <a href="/demander?metier=@Model.Domain" class="font-semibold">@L["Site_Trade_Describe"]</a></p>
</section>

<section class="mt-14 bg-sourdine py-14" aria-labelledby="deroulement-titre">
    <div class="mx-auto w-full max-w-7xl px-4 lg:px-6">
        <h2 id="deroulement-titre" class="sc-section-titre">@L["Site_Trade_HowTitle"]</h2>
        <ol class="mt-6 grid gap-5 md:grid-cols-3">
            @foreach (var (index, key) in new[] { "Site_Trade_How1", "Site_Trade_How2", "Site_Trade_How3" }.Index())
            {
                <li class="rounded-lg border border-ligne bg-surface p-5 shadow-xs">
                    <span class="grid size-9 place-items-center rounded-full bg-laterite font-bold text-sur-accent">@(index + 1)</span>
                    <p class="mt-3 text-[15px]">@L[key]</p>
                </li>
            }
        </ol>
    </div>
</section>

@if (published.Count > 0 || samples.Count > 0)
{
    <section class="mx-auto w-full max-w-7xl px-4 pt-14 lg:px-6" aria-labelledby="avis-metier-titre">
        <div class="flex flex-wrap items-center gap-3">
            <h2 id="avis-metier-titre" class="sc-section-titre">@L["Site_Trade_Reviews", Model.Name]</h2>
        </div>
        <ul class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var review in published)
            {
                <li><partial name="Site/_Review" model='new ReviewCardModel(review.Author, review.Commune, review.GivenAt, review.Score, Model.Name, review.Comment)' /></li>
            }
            @foreach (var review in samples)
            {
                <li><partial name="Site/_Review" model='new ReviewCardModel(review.Author, review.Neighborhood, new DateTimeOffset(review.Date.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero), review.Rating, review.Trade, review.Text)' /></li>
            }
        </ul>
    </section>
}

<section class="mx-auto w-full max-w-7xl px-4 pt-14 lg:px-6" aria-labelledby="autres-titre">
    <h2 id="autres-titre" class="text-xl font-bold text-atlantique">@L["Site_Trade_Others"]</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
        @foreach (var other in others)
        {
            <li><a href="/metiers/@other.Slug" class="sc-btn-secondaire"><sc-icon name="@Formatting.Icon(other.Domain)" class="size-4 text-laterite" />@other.Name</a></li>
        }
    </ul>
</section>

<partial name="Site/_CtaBand" />
