@* Last call at the bottom of a public page (dark Atlantic panel): request a job, or call. *@
<section class="mx-auto w-full max-w-7xl px-4 pt-16 lg:px-6">
    <div class="sc-panneau relative flex flex-col items-start gap-6 overflow-hidden px-6 py-10 sm:px-10 lg:flex-row lg:items-center lg:justify-between lg:px-14">
        <div>
            <p class="font-mono text-xs font-bold tracking-[0.16em] text-or uppercase">@L["Site_Cta_Eyebrow"]</p>
            <h2 class="mt-3 max-w-xl font-display text-2xl leading-tight tracking-[-0.02em] sm:text-[1.875rem]">@L["Site_Cta_Title"]</h2>
            <p class="mt-2 text-sur-nuit/80">@L["Site_Cta_Text"]</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="/demander" class="sc-btn-primaire min-h-12 px-6 text-base">@L["Site_RequestJob"]<sc-icon name="arrow-right" class="size-5" /></a>
            @if (Site.Visible(Site.Contact))
            {
                <a href="tel:@Site.Contact.PhoneLink" class="sc-btn min-h-12 border-white/20 bg-white/5 text-white hover:bg-white/10"><sc-icon name="phone" class="size-5 text-or" />@Site.Contact.PhoneDisplay</a>
            }
        </div>
        <div class="sc-bande-fine absolute inset-x-0 bottom-0"></div>
    </div>
</section>
