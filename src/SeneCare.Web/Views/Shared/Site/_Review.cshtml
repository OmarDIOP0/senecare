@model ReviewCardModel
<figure class="flex h-full flex-col rounded-2xl border border-ligne bg-surface p-6 shadow-carte">
    <div class="flex items-center justify-between gap-3">
        <span class="inline-flex gap-0.5 text-ambre [--icon-fond:var(--ambre)] [--icon-fond-opacite:1]" role="img" aria-label="@L["Home_Review_Stars", Model.Rating]">
            @for (var i = 1; i <= 5; i++)
            {
                <sc-icon name="star" class="size-5 @(i <= Model.Rating ? "" : "text-charbon-pale opacity-40")" />
            }
        </span>
        <span class="sc-badge bg-ocre-clair text-ocre-texte">@Model.Trade</span>
    </div>
    <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed">« @Model.Text »</blockquote>
    <figcaption class="mt-5 flex items-center gap-3 border-t border-ligne pt-4">
        <span class="grid size-10 shrink-0 place-items-center rounded-full bg-nuit font-display text-sm text-or">@Model.Author[..1]</span>
        <span class="text-sm"><span class="block font-bold">@Model.Author</span><span class="text-charbon-doux">@Model.Place · @Formatting.ShortDate(Model.Date)</span></span>
    </figcaption>
</figure>
