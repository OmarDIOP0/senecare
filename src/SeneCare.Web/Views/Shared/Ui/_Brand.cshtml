@* Wordmark: a roof over the name — « Du plan à la réalité ». ViewData["BrandOnDark"]: light version for dark blue bars. *@
@{
    var onDark = ViewData["BrandOnDark"] is true;
}
@* Smaller on narrow phones (360 px): the header also holds « Créer mon compte » and the menu. *@
<a href="/" class="inline-flex min-h-11 shrink-0 items-center gap-1.5 no-underline hover:no-underline sm:gap-2.5 @(onDark ? "text-white" : "text-charbon")" aria-label="@L["App_Name"]">
    <svg viewBox="0 0 32 32" class="size-6 sm:size-7" aria-hidden="true">
        <path d="M3 15 16 5l13 10" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="@(onDark ? "stroke-ambre" : "stroke-laterite")" />
        <path d="M8 14v13h16V14" fill="none" stroke-width="3" stroke-linejoin="round" class="@(onDark ? "stroke-white" : "stroke-charbon")" />
    </svg>
    <span class="font-logo text-[0.8125rem] font-bold min-[380px]:text-[0.9375rem] sm:text-[1.125rem] tracking-[0.04em] uppercase">Sene<span class="@(onDark ? "text-ambre" : "text-laterite")">Care</span></span>
</a>
