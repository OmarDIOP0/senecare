@* Common <head> content for every layout: PWA manifest, icons, fonts, CSS, deferred scripts. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
@* Theme before the first paint (no flash): light by default, « dark », or « system » (follows the phone). *@
<script>
    (function () {
        var t = "light";
        try {
            var s = localStorage.getItem("sc-theme");
            if (s === "dark") t = "dark";
            else if (s === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches) t = "dark";
        } catch (e) { }
        document.documentElement.dataset.theme = t;
    })();
</script>
<meta name="theme-color" content="#f6f3ec" />
@* Phone fields (data-phone): 9 digits starting with one of these, checked while typing. *@
<meta name="sc-phone" content="@string.Join(",", SeneCare.Domain.Users.PhoneNumber.MobilePrefixes)" data-error="@L["Error_phone_invalid"]" />
@* SEO: each public page gives its own description (ViewData["Description"]) and may give a full title (SeoTitle);
   signed-in spaces, sign-in / sign-up and utility pages say « noindex » (ViewData["NoIndex"]). *@
<meta name="description" content="@(ViewData["Description"] as string ?? L["Seo_Default_Description"].Value)" />
@if (ViewData["NoIndex"] is true)
{
    <meta name="robots" content="noindex, nofollow" />
}
<title>@(ViewData["SeoTitle"] as string ?? $"{ViewData["Title"]} · {L["App_Name"]}")</title>
<link rel="manifest" href="/manifest.webmanifest" />
@* Icons: Google search results need a square icon of 48 px or a multiple (PNG / ICO); browsers take the SVG. *@
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="~/img/icons/icon-96.png" sizes="96x96" type="image/png" />
<link rel="icon" href="~/img/icons/icon-192.png" sizes="192x192" type="image/png" />
<link rel="icon" href="~/img/icons/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="~/img/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="SeneCare" />
<link rel="preload" href="~/fonts/bricolage-grotesque-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="~/fonts/unbounded-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
<script src="~/lib/htmx.min.js" asp-append-version="true" defer></script>
<script src="~/js/outbox.js" asp-append-version="true" defer></script>
<script src="~/js/app.js" asp-append-version="true" defer></script>
