@* Common <head> content for every layout: PWA manifest, icons, fonts, CSS, deferred scripts. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)" />
<meta name="description" content="@L["App_Promise"]" />
<title>@ViewData["Title"] · @L["App_Name"]</title>
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="icon" href="~/img/icons/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="~/img/icons/apple-touch-icon.png" />
<meta name="apple-mobile-web-app-title" content="SeneCare" />
<link rel="preload" href="~/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
<script src="~/lib/htmx.min.js" asp-append-version="true" defer></script>
<script src="~/js/outbox.js" asp-append-version="true" defer></script>
<script src="~/js/app.js" asp-append-version="true" defer></script>
