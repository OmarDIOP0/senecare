@* « Installer l'application »: phones only, a thin dismissible bar (dismissal remembered by app.js). *@
<div data-install hidden class="flex items-center gap-3 border-b border-ligne bg-surface px-4 py-2 text-sm lg:hidden!">
    <p class="flex-1">@L["Install_Title"]</p>
    <button type="button" class="font-medium text-laterite" data-install-accept>@L["Install_Button"]</button>
    <button type="button" class="sc-btn-icone size-8" data-install-dismiss aria-label="@L["Install_Later"]"><sc-icon name="x" class="size-4" /></button>
</div>

<sc-sheet id="installer-iphone" title="@L["Install_Ios_Title"]">
    <ol class="grid gap-3 text-sm">
        <li class="flex items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-md bg-sourdine text-charbon-doux">
                @* iOS « Partager » symbol (square with arrow): not in our icon set. *@
                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M8 7l4-4 4 4" /><path d="M6 11H5a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1h-1" /></svg>
            </span>
            @L["Install_Ios_Step1"]
        </li>
        <li class="flex items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-md bg-sourdine text-charbon-doux"><sc-icon name="plus" class="size-4" /></span>
            @L["Install_Ios_Step2"]
        </li>
        <li class="flex items-center gap-3">
            <span class="grid size-8 shrink-0 place-items-center rounded-md bg-sourdine text-charbon-doux"><sc-icon name="check" class="size-4" /></span>
            @L["Install_Ios_Step3"]
        </li>
    </ol>
    <button type="button" class="sc-btn-primaire mt-4 w-full" data-sheet-close>@L["Install_Ios_Ok"]</button>
</sc-sheet>
