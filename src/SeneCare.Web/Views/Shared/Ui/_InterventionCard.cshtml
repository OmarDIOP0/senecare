@model InterventionCardModel
@{
    var stripe = Model.Urgency switch
    {
        Urgency.Critical => "bg-laterite",
        Urgency.High => "bg-soleil",
        _ => "bg-transparent",
    };
    var whatsApp = Model.TechnicianPhoneE164?.TrimStart('+');
}
<article class="sc-carte relative overflow-hidden pl-5">
    <span class="absolute inset-y-0 left-0 w-1.5 @stripe" aria-hidden="true"></span>
    <div class="flex items-start gap-3">
        <span class="grid size-9 shrink-0 place-items-center rounded-md bg-sourdine text-charbon-doux">
            <sc-icon name="@Formatting.Icon(Model.Domain)" class="size-6" />
        </span>
        <div class="min-w-0 flex-1">
            <p class="text-xs font-bold text-charbon-doux">@L["Domain_" + Model.Domain] · @Model.Number</p>
            <h3 class="mt-0.5 text-[15px] font-semibold">
                <a href="@Model.Url" class="text-charbon no-underline after:absolute after:inset-0 hover:underline">@Model.Title</a>
            </h3>
            <div class="mt-2 flex flex-wrap gap-1.5">
                <sc-status value="@Model.Status" />
                <sc-urgency value="@Model.Urgency" />
            </div>
        </div>
    </div>

    @if (Model.AppointmentAt is not null || Model.TechnicianName is not null)
    {
        <dl class="mt-3 grid gap-1 border-t border-dashed border-ligne pt-3 text-sm">
            @if (Model.AppointmentAt is { } at)
            {
                <div class="flex items-center gap-2"><dt><sc-icon name="calendar" class="size-4 text-charbon-doux" label="@L["Card_Appointment"]" /></dt><dd class="font-bold">@Formatting.ShortDateTime(at)</dd></div>
            }
            @if (Model.TechnicianName is not null)
            {
                <div class="flex items-center gap-2"><dt><sc-icon name="wrench" class="size-4 text-charbon-doux" label="@L["Card_Technician"]" /></dt><dd>@Model.TechnicianName</dd></div>
            }
        </dl>
    }

    @if (Model.TechnicianPhoneE164 is not null)
    {
        @* Above the stretched link (z-10) so both buttons stay clickable. *@
        <div class="relative z-10 mt-3 grid grid-cols-2 gap-2">
            <a href="tel:@Model.TechnicianPhoneE164" class="sc-btn-secondaire"><sc-icon name="phone" />@L["Card_Call"]</a>
            <a href="https://wa.me/@whatsApp" class="sc-btn-whatsapp" rel="noopener"><sc-icon name="message-circle" />WhatsApp</a>
        </div>
    }
</article>
