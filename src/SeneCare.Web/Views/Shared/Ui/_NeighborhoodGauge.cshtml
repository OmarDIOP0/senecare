@model SeneCare.Application.Subscriptions.NeighborhoodProgress
@using SeneCare.Domain.Neighborhoods
@{
    var active = Model.Status == NeighborhoodProgramStatus.Active;
    var percent = Math.Min(100, 100 * Model.Members / Math.Max(1, Model.Threshold));
}
@* « 347 / 500 voisins »: the neighborhood program gauge. *@
<section class="sc-carte" aria-labelledby="quartier-titre">
    <div class="flex items-baseline justify-between gap-2">
        <h2 id="quartier-titre" class="text-sm font-medium text-charbon-doux">@L["Hood_Program"] · @Model.Neighborhood</h2>
        @if (active)
        {
            <span class="sc-badge bg-baobab-clair text-baobab">@L["ProgramStatus_Active"]</span>
        }
    </div>
    @if (active)
    {
        <p class="mt-2 text-sm">@L["Hood_Active", Model.TreesPlanted]</p>
    }
    else
    {
        <p class="mt-2 tabular-nums"><span class="text-2xl font-semibold tracking-tight">@Model.Members</span> <span class="text-sm text-charbon-doux">/ @L["Hood_Neighbors", Model.Threshold]</span></p>
        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-sourdine" role="progressbar" aria-valuemin="0" aria-valuemax="@Model.Threshold" aria-valuenow="@Model.Members" aria-label="@L["Hood_Program"]">
            <div class="h-full rounded-full bg-baobab" style="width: @percent%"></div>
        </div>
        <p class="mt-2 text-[13px] text-charbon-doux">@L["Hood_Remaining", Math.Max(0, Model.Threshold - Model.Members)]</p>
    }
</section>
