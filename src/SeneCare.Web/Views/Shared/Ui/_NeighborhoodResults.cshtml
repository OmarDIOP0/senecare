@model IReadOnlyList<SeneCare.Application.Locations.NeighborhoodOption>
@{
    var field = ViewData["Field"] as string ?? string.Empty;
    var typed = Context.Request.Query["q"].ToString().Trim();
    var communes = ViewData["Communes"] as IReadOnlyList<SeneCare.Application.Locations.CommuneOption> ?? [];
}
@if (Model.Count == 0 && typed.Length >= 2)
{
    @* Missing from the list: the person adds it, attached to its commune (an admin reviews additions). *@
    <li class="grid gap-3 px-3 py-3" data-hood-add="@field" data-hood-name="@typed">
        <p class="text-sm text-charbon-doux">@L["Picker_NoResult", typed]</p>
        <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-end">
            <div>
                <label class="sc-label" for="@field-commune">@L["Picker_AddCommune"]</label>
                <select id="@field-commune" class="sc-input" data-hood-commune>
                    <option value="">@L["Picker_AddChoose"]</option>
                    @foreach (var group in communes.GroupBy(c => c.Department))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var commune in group)
                            {
                                <option value="@commune.Id">@commune.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            <button type="button" class="sc-btn-secondaire" data-hood-submit data-text-choose="@L["Picker_AddChoose"]">
                <sc-icon name="plus" class="size-4" />@L["Picker_AddButton", typed]
            </button>
        </div>
    </li>
}
@foreach (var option in Model)
{
    <li role="option" aria-selected="false">
        <button type="button" data-pick="@field" data-pick-id="@option.Id" data-pick-label="@option.Name (@option.Commune)"
                class="flex min-h-cible w-full items-center gap-3 px-3 py-2 text-left text-charbon hover:bg-laterite-clair/60 focus-visible:bg-laterite-clair/60">
            <sc-icon name="map-pin" class="size-5 text-laterite" />
            <span>
                <span class="font-medium">@option.Name</span>
                <span class="block text-sm text-charbon-doux">@option.Context</span>
            </span>
        </button>
    </li>
}
