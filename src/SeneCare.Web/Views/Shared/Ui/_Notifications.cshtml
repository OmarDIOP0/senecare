@model IReadOnlyList<SeneCare.Application.Users.InAppNotification>
<div class="flex items-center justify-between border-b border-ligne px-3 py-2">
    <p class="text-sm font-medium">@L["Shell_Notifications"]</p>
</div>
@if (Model.Count == 0)
{
    <div class="px-4 py-8 text-center">
        <span class="mx-auto grid size-10 place-items-center rounded-md bg-sourdine text-charbon-doux"><sc-icon name="bell" class="size-5" /></span>
        <p class="mt-3 text-sm font-medium">@L["Notif_Empty_Title"]</p>
        <p class="mt-1 text-[13px] text-charbon-doux">@L["Notif_Empty_Text"]</p>
    </div>
}
else
{
    <ul class="max-h-96 overflow-y-auto">
        @foreach (var n in Model)
        {
            var text = L["Notif_" + n.TemplateKey.Replace('.', '_')];
            <li class="border-b border-ligne px-3 py-2.5 last:border-b-0">
                <p class="flex items-start gap-2 text-sm">
                    @if (n.IsUnread)
                    {
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-laterite" aria-hidden="true"></span>
                    }
                    <span>@(text.ResourceNotFound ? n.TemplateKey : text.Value)</span>
                </p>
                <p class="mt-0.5 text-xs text-charbon-doux">@Formatting.ShortDateTime(n.At)</p>
            </li>
        }
    </ul>
}
