@model PasswordInputModel
@{
    var id = Model.Name.Replace('.', '_');
}
<div data-password>
    <label class="sc-label" for="@id">@Model.Label</label>
    <div class="relative mt-1.5">
        <input id="@id" name="@Model.Name" type="password" class="sc-input mt-0 pr-24" required
               minlength="@(Model.NewPassword ? SeneCare.Application.Auth.PasswordRules.MinLength : 1)"
               autocomplete="@(Model.NewPassword ? "new-password" : "current-password")" autocapitalize="off" spellcheck="false"
               aria-invalid="@(Model.Error is null ? "false" : "true")" aria-describedby="@id-aide @id-erreur" />
        <button type="button" class="absolute inset-y-0 right-1 my-1 rounded-md px-3 text-sm font-semibold text-laterite hover:bg-sourdine"
                data-password-toggle data-text-show="@L["Password_Show"]" data-text-hide="@L["Password_Hide"]" aria-controls="@id" aria-pressed="false">@L["Password_Show"]</button>
    </div>
    @if ((Model.Hint ?? (Model.NewPassword ? L["Password_Hint", SeneCare.Application.Auth.PasswordRules.MinLength].Value : null)) is { } hint)
    {
        <p id="@id-aide" class="sc-aide">@hint</p>
    }
    <p id="@id-erreur" class="sc-error" role="alert">@Model.Error</p>
</div>
