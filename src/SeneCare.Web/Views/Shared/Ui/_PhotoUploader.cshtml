@model PhotoUploaderModel
@{
    var id = Model.Id ?? Model.Name.Replace('.', '_');
}
<div data-uploader data-max="@Model.MaxPhotos" data-max-bytes="307200"
     data-working-text="@L["Uploader_Working"]" data-remove-text="@L["Uploader_Remove"]" data-empty-text="@L["Uploader_Hint", Model.MaxPhotos]">
    <span class="sc-label" id="@id-label">@Model.Label</span>
    <ul class="mt-2 grid grid-cols-3 gap-2 empty:hidden sm:grid-cols-4" data-previews aria-labelledby="@id-label"></ul>
    <label class="mt-1.5 flex min-h-20 cursor-pointer flex-col items-center justify-center gap-1 rounded-md border border-dashed border-ligne bg-surface px-3 py-3 text-center text-sm text-charbon-doux hover:bg-sourdine has-focus-visible:outline-2 has-focus-visible:outline-laterite">
        <sc-icon name="camera" class="size-5" />
        <span>@L["Uploader_Add"]</span>
        <input id="@id" name="@Model.Name" type="file" accept="image/*" multiple class="sr-only" data-uploader-input aria-describedby="@id-statut" />
    </label>
    <p id="@id-statut" class="sc-aide" data-uploader-status aria-live="polite">@L["Uploader_Hint", Model.MaxPhotos]</p>
</div>
