@* Loading placeholder shaped like an intervention card (instead of a spinner). *@
<div class="sc-carte" aria-hidden="true">
    <div class="flex items-start gap-3">
        <div class="sc-skeleton size-12 shrink-0"></div>
        <div class="flex-1 space-y-2">
            <div class="sc-skeleton h-3 w-1/3"></div>
            <div class="sc-skeleton h-5 w-3/4"></div>
            <div class="flex gap-2"><div class="sc-skeleton h-5 w-20 rounded-full"></div><div class="sc-skeleton h-5 w-16 rounded-full"></div></div>
        </div>
    </div>
</div>
<span class="sr-only" role="status">@L["Common_Loading"]</span>
