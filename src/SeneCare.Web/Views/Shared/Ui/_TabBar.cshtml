@model ShellModel
@{
    var items = Model.Nav.Mobile;
    var primary = Model.Nav.Primary;
    // Primary action in the middle: [a, b, Signaler, c, Plus] — or [a, b, c?, Plus] without one.
    IReadOnlyList<NavItem> before = primary is null ? items : items.Take(2).ToList();
    IReadOnlyList<NavItem> after = primary is null ? Array.Empty<NavItem>() : items.Skip(2).ToList();
    var moreActive = Model.ActiveKey == AppNavigation.Settings.Key || Model.Nav.More.Any(i => i.Key == Model.ActiveKey);
    string Tab(bool active) => active ? "text-charbon" : "text-charbon-pale";
}
<nav aria-label="@L["Tab_NavLabel"]" class="fixed inset-x-0 bottom-0 z-40 border-t border-ligne bg-surface pb-[env(safe-area-inset-bottom)] lg:hidden">
    <ul class="mx-auto flex max-w-md">
        @foreach (var item in before)
        {
            var active = item.Key == Model.ActiveKey;
            <li class="flex-1">
                <a href="@item.Url" data-tour="@item.Tour" aria-current="@(active ? "page" : null)"
                   class="flex h-14 flex-col items-center justify-center gap-0.5 text-[11px] font-medium no-underline hover:no-underline @Tab(active)">
                    <sc-icon name="@item.Icon" class="size-5 @(active ? "text-laterite" : "")" />@L[item.LabelKey]
                </a>
            </li>
        }
        @if (primary is not null)
        {
            <li class="flex flex-1 items-center justify-center">
                <a href="@primary.Url" data-tour="@primary.Tour" class="flex h-10 items-center gap-1.5 rounded-md bg-laterite px-3 text-[13px] font-medium text-sur-accent no-underline hover:no-underline">
                    <sc-icon name="@primary.Icon" class="size-4" />@L[primary.LabelKey]
                </a>
            </li>
        }
        @foreach (var item in after)
        {
            var active = item.Key == Model.ActiveKey;
            <li class="flex-1">
                <a href="@item.Url" data-tour="@item.Tour" aria-current="@(active ? "page" : null)"
                   class="flex h-14 flex-col items-center justify-center gap-0.5 text-[11px] font-medium no-underline hover:no-underline @Tab(active)">
                    <sc-icon name="@item.Icon" class="size-5 @(active ? "text-laterite" : "")" />@L[item.LabelKey]
                </a>
            </li>
        }
        <li class="flex-1">
            <button type="button" data-sheet-open="plus" class="flex h-14 w-full flex-col items-center justify-center gap-0.5 text-[11px] font-medium @Tab(moreActive)">
                <sc-icon name="ellipsis" class="size-5 @(moreActive ? "text-laterite" : "")" />@L["Shell_More"]
            </button>
        </li>
    </ul>
</nav>

<sc-sheet id="plus" title="@L["Shell_More"]">
    <ul class="grid gap-0.5">
        @foreach (var item in Model.Nav.More.Append(AppNavigation.Settings))
        {
            <li>
                <a href="@item.Url" class="sc-menu-item min-h-11"><sc-icon name="@item.Icon" class="size-[18px] text-charbon-doux" />@L[item.LabelKey]</a>
            </li>
        }
        <li>
            <form method="post" action="/visite/rejouer">
                @Html.AntiForgeryToken()
                <button type="submit" class="sc-menu-item min-h-11"><sc-icon name="life-buoy" class="size-[18px] text-charbon-doux" />@L["Shell_Help"]</button>
            </form>
        </li>
    </ul>
    <p class="mt-4 px-2 text-xs text-charbon-doux">@L["Shell_Theme"]</p>
    <div class="mt-1 grid grid-cols-3 gap-1" role="group" aria-label="@L["Shell_Theme"]">
        <button type="button" class="sc-btn-secondaire" data-theme-set="light">@L["Shell_ThemeLight"]</button>
        <button type="button" class="sc-btn-secondaire" data-theme-set="dark">@L["Shell_ThemeDark"]</button>
        <button type="button" class="sc-btn-secondaire" data-theme-set="system">@L["Shell_ThemeSystem"]</button>
    </div>
    <form method="post" action="/deconnexion" class="mt-4">
        @Html.AntiForgeryToken()
        <button type="submit" class="sc-btn-secondaire w-full"><sc-icon name="log-out" class="size-4" />@L["Account_SignOut"]</button>
    </form>
</sc-sheet>
