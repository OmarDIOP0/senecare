@* Signed-in space: sidebar + topbar on desktop, compact header + bottom tab bar on phones. *@
@using SeneCare.Infrastructure.Identity
@inject SeneCare.Application.Users.GetUserProfileHandler Profiles
@inject SeneCare.Application.Users.NotificationInbox Inbox
@{
    var nav = AppNavigation.For(User);
    var active = ViewData["NavActive"] as string ?? "espace";
    var userId = User.GetUserId();
    var profile = userId is { } id ? await Profiles.HandleAsync(id, Context.RequestAborted) : null;
    var shell = new ShellModel(
        nav,
        active,
        ViewData["Title"] as string,
        profile,
        userId is { } uid ? await Inbox.UnreadCountAsync(uid, Context.RequestAborted) : 0);
    // Technicians work outside: stronger contrast and bigger targets everywhere in their app.
    var terrain = nav.TourKey == SeneCare.Application.Users.TourKeys.Technician ? "sc-terrain" : string.Empty;
    var width = ViewData["Wide"] is true ? "max-w-[1200px]" : "max-w-3xl";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <partial name="Ui/_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="sc-app min-h-dvh @terrain">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-charbon">@L["Layout_SkipToContent"]</a>
    <partial name="Ui/_Sidebar" model="shell" />
    <div class="lg:pl-60">
        <partial name="Ui/_Topbar" model="shell" />
        <partial name="Ui/_InstallPrompt" />
        <main id="contenu" class="w-full @width px-4 pt-5 pb-28 lg:px-8 lg:pt-8 lg:pb-12">
            @RenderBody()
        </main>
    </div>
    <partial name="Ui/_TabBar" model="shell" />
    <partial name="Ui/_CommandPalette" model="shell" />
    <partial name="Ui/_Toasts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
