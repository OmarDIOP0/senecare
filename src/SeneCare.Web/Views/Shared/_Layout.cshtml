<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <partial name="Ui/_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-dvh">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-charbon">@L["Layout_SkipToContent"]</a>
    <header class="border-b border-ligne bg-surface">
        <nav class="mx-auto flex h-14 w-full max-w-screen-lg items-center justify-between gap-2 px-4">
            <partial name="Ui/_Brand" />
            <div class="flex items-center gap-1">
                <partial name="Ui/_AppStatus" />
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/espace" class="sc-btn-secondaire">@L["Nav_Space"]</a>
                }
                else if (!Context.Request.Path.StartsWithSegments("/connexion"))
                {
                    <a href="/connexion" class="sc-btn-secondaire">@L["Nav_SignIn"]</a>
                }
            </div>
        </nav>
    </header>
    <main id="contenu" class="mx-auto w-full @(ViewData["Wide"] is true ? "max-w-screen-lg" : "max-w-screen-md") px-4 py-8">
        @RenderBody()
    </main>
    <partial name="Ui/_Toasts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
