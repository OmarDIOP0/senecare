@* Public site: thin contact bar, white header with the trades menu, dense footer, call / WhatsApp bar on phones.
   ViewData["FullWidth"] lets a page draw its own full-width sections. Contact details: Admin › Paramètres. *@
@{
    // Account finished: « Mon espace ». Signed in but sign-up unfinished (often left on a phone): the sign-in page,
    // which offers to finish it or to use another number.
    var signedIn = User.Identity?.IsAuthenticated == true && SeneCare.Infrastructure.Identity.ClaimsPrincipalExtensions.IsRegistered(User);
    var onSignIn = Context.Request.Path.StartsWithSegments("/connexion") || Context.Request.Path.StartsWithSegments("/inscription");
    var fullWidth = ViewData["FullWidth"] is true;
    var contact = await SiteContact.GetAsync();
    var showContact = contact.HasPhone || contact.HasWhatsApp;
    var menu = new (string Href, string Label)[]
    {
        ("/particuliers", L["Public_Nav_Households"].Value),
        ("/entreprises", L["Public_Nav_Business"].Value),
        ("/quartiers", L["Public_Nav_Neighborhoods"].Value),
        ("/tarifs", L["Site_Nav_Pricing"].Value),
    };
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <partial name="Ui/_Head" />
    <partial name="Site/_Seo" />
    @await RenderSectionAsync("Head", required: false)
</head>
@* Room for the phone action bar (its exact height, home indicator included) so nothing ends hidden under it. *@
<body class="flex min-h-dvh flex-col @(onSignIn || !(signedIn || showContact) ? "" : "pb-[calc(3.5625rem_+_max(0.5rem,env(safe-area-inset-bottom)))] lg:pb-0")">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2 focus:text-charbon">@L["Layout_SkipToContent"]</a>

    @* ---- Thin contact bar ---- *@
    @if (showContact)
    {
        <div class="bg-nuit-2 text-sm text-sur-nuit">
            <div class="mx-auto flex min-h-9 w-full max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-0 lg:px-6 lg:py-1.5">
                <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
                    @if (contact.HasPhone)
                    {
                        <a href="tel:@contact.PhoneLink" class="sc-tap inline-flex items-center gap-1.5 font-semibold text-white no-underline hover:underline"><sc-icon name="phone" class="size-4" />@contact.PhoneDisplay</a>
                    }
                    @if (contact.HasWhatsApp)
                    {
                        @* Phones and tablets have WhatsApp in the bottom bar. *@
                        <a href="@contact.WhatsAppUrl" class="hidden items-center gap-1.5 text-white no-underline hover:underline lg:inline-flex" target="_blank" rel="noopener"><sc-icon name="message-circle" class="size-4" />WhatsApp</a>
                    }
                </div>
                <div class="hidden flex-wrap items-center gap-x-5 md:flex">
                    @if (contact.Hours is { } hours)
                    {
                        <span class="inline-flex items-center gap-1.5"><sc-icon name="clock" class="size-4" />@hours</span>
                    }
                    @if (contact.Areas is { } areas)
                    {
                        <span class="inline-flex items-center gap-1.5"><sc-icon name="map-pin" class="size-4" />@areas</span>
                    }
                </div>
            </div>
        </div>
    }

    @* ---- Header ---- *@
    <header class="sticky top-0 z-40 bg-nuit text-sur-nuit [&_.sc-btn-icone]:text-sur-nuit [&_.sc-btn-icone:hover]:bg-white/10 [&_.sc-btn-icone:hover]:text-white">
        <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-2 sm:gap-4 px-4 lg:h-[4.5rem] lg:px-6">
            <partial name="Ui/_Brand" view-data='new ViewDataDictionary(ViewData) { ["BrandOnDark"] = true }' />
            <nav class="hidden items-center gap-1 xl:flex" aria-label="@L["Public_Nav_Label"]">
                <details class="relative" data-menu>
                    <summary class="flex cursor-pointer list-none items-center gap-1 rounded-full px-3.5 py-2 text-[15px] font-semibold text-sur-nuit hover:bg-white/10 hover:text-white [&::-webkit-details-marker]:hidden">
                        @L["Public_Nav_Trades"]<sc-icon name="chevron-down" class="size-4" />
                    </summary>
                    <div class="sc-menu left-0 w-72">
                        @foreach (var trade in Site.Trades)
                        {
                            <a href="/metiers/@trade.Slug" class="sc-menu-item items-start py-2">
                                <sc-icon name="@Formatting.Icon(trade.Domain)" class="mt-0.5 size-4 text-laterite" />
                                <span><span class="block font-semibold">@trade.Name</span><span class="block text-xs text-charbon-doux">@trade.Summary</span></span>
                            </a>
                        }
                        <a href="/metiers" class="sc-menu-item mt-1 border-t border-ligne pt-2 font-semibold text-laterite">@L["Site_AllTrades"]</a>
                    </div>
                </details>
                @foreach (var (href, label) in menu)
                {
                    <a href="@href" class="rounded-full px-3.5 py-2 text-[15px] font-semibold text-sur-nuit no-underline hover:bg-white/10 hover:text-white hover:no-underline">@label</a>
                }
            </nav>
            @* The one orange action is « Demander une intervention » (someone with a leak wants a technician). Signing in
               is discreet: a text link, an icon on small screens. « Créer mon compte » is in ☰ and on the sign-in page. *@
            <div class="flex shrink-0 items-center gap-0.5 sm:gap-2">
                <partial name="Ui/_AppStatus" />
                <div class="hidden md:block"><partial name="Site/_ThemeSwitch" /></div>
                @if (!onSignIn)
                {
                    var accountUrl = signedIn ? "/espace" : "/connexion";
                    var accountLabel = signedIn ? L["Nav_Space"].Value : L["Nav_SignIn"].Value;
                    <a href="@accountUrl" class="hidden min-h-11 items-center rounded-full px-3 text-[15px] font-semibold whitespace-nowrap text-white underline-offset-4 hover:bg-white/10 hover:underline md:inline-flex">@accountLabel</a>
                    <a href="@accountUrl" class="sc-btn-icone md:hidden" aria-label="@accountLabel" title="@accountLabel"><sc-icon name="circle-user" /></a>
                    @* Home page: the quick request form just below. Elsewhere: the request route. Short label on phones. *@
                    <a href="@(Context.Request.Path == "/" ? "#reservation" : "/demander")" class="sc-btn-primaire whitespace-nowrap max-sm:px-4">
                        <span class="sm:hidden">@L["Site_RequestJob_Short"]</span><span class="hidden sm:inline">@L["Site_RequestJob"]</span>
                    </a>
                }
                @* ☰ only while the menu does not fit in the bar: from 1280 px, trades and pages are all visible. *@
                <details class="relative xl:hidden" data-menu>
                    <summary class="sc-btn-icone list-none [&::-webkit-details-marker]:hidden" aria-label="@L["Public_Nav_Label"]"><sc-icon name="menu" /></summary>
                    <div class="sc-menu right-0 max-h-[80dvh] w-72 overflow-y-auto">
                        @if (!signedIn)
                        {
                            @* Phones only: from 768 px « Se connecter » is already in the bar. *@
                            <a href="/connexion" class="sc-btn-secondaire mb-1.5 w-full md:hidden"><sc-icon name="circle-user" class="size-5 text-laterite" />@L["Nav_SignIn"]</a>
                        }
                        @* Trades folded: seven lines would push everything else down. *@
                        <details class="group/trades">
                            <summary class="sc-menu-item cursor-pointer list-none justify-between font-semibold [&::-webkit-details-marker]:hidden">
                                @L["Public_Nav_Trades"]<sc-icon name="chevron-down" class="size-4 transition-transform group-open/trades:rotate-180" />
                            </summary>
                            <div class="mb-1 ml-2 border-l border-ligne pl-1">
                                @foreach (var trade in Site.Trades)
                                {
                                    <a href="/metiers/@trade.Slug" class="sc-menu-item"><sc-icon name="@Formatting.Icon(trade.Domain)" class="size-4 text-laterite" />@trade.Name</a>
                                }
                                <a href="/metiers" class="sc-menu-item font-semibold text-laterite">@L["Site_AllTrades"]</a>
                            </div>
                        </details>
                        @foreach (var (href, label) in menu)
                        {
                            <a href="@href" class="sc-menu-item font-semibold">@label</a>
                        }
                        <div class="my-1 border-t border-ligne"></div>
                        @if (signedIn)
                        {
                            <a href="/espace" class="sc-menu-item"><sc-icon name="circle-user" class="size-4" />@L["Nav_Space"]</a>
                        }
                        else
                        {
                            <a href="/inscription" class="sc-menu-item font-semibold"><sc-icon name="circle-user" class="size-4" />@L["Register_Submit"]</a>
                        }
                        @* Phones: the theme choice lives here (no room for its button in the bar). *@
                        <div class="mt-1 grid grid-cols-3 gap-1 md:hidden" role="group" aria-label="@L["Site_Theme"]">
                            <button type="button" class="sc-btn-secondaire min-h-11 px-2 text-sm" data-theme-set="light">@L["Shell_ThemeLight"]</button>
                            <button type="button" class="sc-btn-secondaire min-h-11 px-2 text-sm" data-theme-set="dark">@L["Shell_ThemeDark"]</button>
                            <button type="button" class="sc-btn-secondaire min-h-11 px-2 text-sm" data-theme-set="system">@L["Shell_ThemeSystem"]</button>
                        </div>
                        <button type="button" class="sc-menu-item w-full" data-install data-install-accept hidden><sc-icon name="download" class="size-4" />@L["Install_Button"]</button>
                    </div>
                </details>
            </div>
        </div>
        <div class="sc-bande-fine"></div>
        @* « Installer l'application » (phones, when the browser allows it): on the public site too, not only in the space. *@
        <partial name="Ui/_InstallPrompt" />
    </header>

    <main id="contenu" class="@(fullWidth ? "w-full flex-1" : $"mx-auto w-full flex-1 {(ViewData["Wide"] is true ? "max-w-screen-lg" : "max-w-screen-md")} px-4 py-10")">
        @RenderBody()
    </main>

    @* ---- Footer: trades, neighbourhoods, company, help, contact ---- *@
    <footer class="mt-20 bg-nuit text-sur-nuit [&_a]:text-sur-nuit [&_a:hover]:text-white">
        <div class="sc-bande"></div>
        <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-5 lg:px-6">
            <div>
                <h2 class="font-mono text-xs font-bold tracking-[0.16em] text-or uppercase">@L["Public_Nav_Trades"]</h2>
                <ul class="mt-4 grid gap-2.5 text-[15px] max-lg:gap-0">
                    @foreach (var trade in Site.Trades)
                    {
                        <li><a href="/metiers/@trade.Slug" class="sc-tap no-underline hover:underline">@trade.Name</a></li>
                    }
                </ul>
            </div>
            <div>
                <h2 class="font-mono text-xs font-bold tracking-[0.16em] text-or uppercase">@L["Site_Footer_Areas"]</h2>
                <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-[15px] max-lg:gap-y-0 lg:grid-cols-1">
                    @foreach (var hood in Site.Neighborhoods.Take(12))
                    {
                        <li>@hood</li>
                    }
                    <li><a href="/quartiers" class="sc-tap font-semibold no-underline hover:underline">@L["Site_Footer_AllAreas"]</a></li>
                </ul>
            </div>
            <div>
                <h2 class="font-mono text-xs font-bold tracking-[0.16em] text-or uppercase">@L["App_Name"]</h2>
                <ul class="mt-4 grid gap-2.5 text-[15px] max-lg:gap-0">
                    <li><a href="/particuliers" class="sc-tap no-underline hover:underline">@L["Public_Nav_Households"]</a></li>
                    <li><a href="/entreprises" class="sc-tap no-underline hover:underline">@L["Public_Nav_Business"]</a></li>
                    <li><a href="/tarifs" class="sc-tap no-underline hover:underline">@L["Site_Nav_Pricing"]</a></li>
                    <li><a href="/quartiers" class="sc-tap no-underline hover:underline">@L["Site_Footer_Program"]</a></li>
                    <li><a href="/classement-quartiers" class="sc-tap no-underline hover:underline">@L["Public_Footer_Ranking"]</a></li>
                </ul>
            </div>
            <div>
                <h2 class="font-mono text-xs font-bold tracking-[0.16em] text-or uppercase">@L["Site_Footer_Help"]</h2>
                <ul class="mt-4 grid gap-2.5 text-[15px] max-lg:gap-0">
                    <li><a href="/faq" class="sc-tap no-underline hover:underline">@L["Site_Faq"]</a></li>
                    <li><a href="/connexion" class="sc-tap no-underline hover:underline">@L["Public_ClientSpace"]</a></li>
                    <li><a href="/demander" class="sc-tap no-underline hover:underline">@L["Site_RequestJob"]</a></li>
                    <li><a href="/confidentialite" class="sc-tap no-underline hover:underline">@L["Public_Footer_Privacy"]</a></li>
                </ul>
            </div>
            <div>
                <h2 class="font-mono text-xs font-bold tracking-[0.16em] text-or uppercase">@L["Site_Footer_Contact"]</h2>
                @if (showContact)
                {
                    <ul class="mt-4 grid gap-2.5 text-[15px] max-lg:gap-0">
                        @if (contact.HasPhone)
                        {
                            <li><a href="tel:@contact.PhoneLink" class="sc-tap inline-flex items-center gap-2 font-semibold no-underline hover:underline"><sc-icon name="phone" class="size-4" />@contact.PhoneDisplay</a></li>
                        }
                        @if (contact.HasWhatsApp)
                        {
                            <li><a href="@contact.WhatsAppUrl" class="sc-tap inline-flex items-center gap-2 no-underline hover:underline" target="_blank" rel="noopener"><sc-icon name="message-circle" class="size-4" />WhatsApp</a></li>
                        }
                        @if (contact.Email is { } email)
                        {
                            <li><a href="mailto:@email" class="sc-tap inline-flex items-center gap-2 no-underline hover:underline"><sc-icon name="mail" class="size-4" />@email</a></li>
                        }
                        @if (contact.Address is { } address)
                        {
                            <li class="flex items-start gap-2"><sc-icon name="map-pin" class="mt-0.5 size-4" />@address</li>
                        }
                        @if (contact.Hours is { } openingHours)
                        {
                            <li class="flex items-start gap-2"><sc-icon name="clock" class="mt-0.5 size-4" />@openingHours</li>
                        }
                    </ul>
                    <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                        @foreach (var social in contact.Social)
                        {
                            <a href="@social.Url" target="_blank" rel="noopener" class="sc-tap underline">@social.Name</a>
                        }
                    </p>
                }
                else
                {
                    <p class="mt-4 text-[15px]"><a href="/connexion" class="sc-tap underline">@L["Public_ClientSpace"]</a></p>
                }
            </div>
        </div>
        <div class="border-t border-white/10">
            <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-5 text-sm lg:px-6">
                <p>© @DateTime.UtcNow.Year SENE DESIGN · @L["App_Signature"]</p>
                <p class="flex flex-wrap gap-x-5 gap-y-1">
                    <a href="/mentions-legales" class="sc-tap no-underline hover:underline">@L["Site_Legal"]</a>
                    <a href="/cgu" class="sc-tap no-underline hover:underline">@L["Site_Terms"]</a>
                    <a href="/confidentialite" class="sc-tap no-underline hover:underline">@L["Public_Footer_Privacy"]</a>
                </p>
            </div>
            @if (ViewData["PhotoCredits"] is true)
            {
                @* Unsplash licence: attribution not required, given anyway. *@
                <p class="mx-auto w-full max-w-7xl px-4 pb-5 text-xs lg:px-6">@L["Public_Footer_Photos"]
                    <a href="https://unsplash.com/@@emmages" rel="noopener" class="sc-tap underline">Emmanuel Ikwuegbu</a>,
                    <a href="https://unsplash.com/@@mkumbwajr" rel="noopener" class="sc-tap underline">Ali Mkumbwa</a> / Unsplash</p>
            }
        </div>
    </footer>

    @* ---- Phones: talk to SeneCare at once (« Appeler », WhatsApp) or, signed in, follow one's requests (« Mon suivi »).
       Secondary style: the one orange action is « Demander une intervention » in the header. Number and WhatsApp link
       come from Admin › Paramètres. Not on sign-in / sign-up: it hid the form's buttons. ---- *@
    @if (!onSignIn && (signedIn || showContact))
    {
        <div class="fixed inset-x-0 bottom-0 z-40 grid auto-cols-fr grid-flow-col gap-2 border-t border-ligne bg-surface p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] lg:hidden">
            @if (signedIn)
            {
                <a href="/interventions" class="sc-btn-secondaire min-h-12"><sc-icon name="list-checks" class="size-5 text-laterite" />@L["Nav_Tracking"]</a>
            }
            else if (contact.HasPhone)
            {
                <a href="tel:@contact.PhoneLink" class="sc-btn-secondaire min-h-12"><sc-icon name="phone" class="size-5 text-laterite" />@L["Card_Call"]</a>
            }
            @if (contact.HasWhatsApp)
            {
                <a href="@contact.WhatsAppUrl" class="sc-btn-secondaire min-h-12" target="_blank" rel="noopener"><sc-icon name="message-circle" class="size-5 text-laterite" />WhatsApp</a>
            }
        </div>
    }

    <partial name="Ui/_Toasts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
