@model SpaceViewModel
@using SeneCare.Application.Users
@using SeneCare.Domain.Billing
@{
    Layout = "_AppLayout";
    ViewData["Title"] = L["Tab_Home"];
    ViewData["NavActive"] = "espace";
    var today = Formatting.ToDakar(DateTimeOffset.UtcNow);
    var dateText = today.ToString("dddd d MMMM", System.Globalization.CultureInfo.CurrentCulture);
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
}

@* The guided tour reads this (not executed: type="application/json"). *@
@if (Model.TourJson is not null)
{
    <script type="application/json" id="sc-tour">@Html.Raw(Model.TourJson)</script>
    @Html.AntiForgeryToken()
}

<header>
    <h1 class="text-xl font-semibold tracking-tight">@(Model.FirstName is null ? L["Space_Hello"] : L["Space_HelloName", Model.FirstName])</h1>
    <p class="mt-0.5 text-sm text-charbon-doux">
        @if (Model.AccountName is { } account)
        {
            <span>@account · </span>
        }
        <span class="first-letter:uppercase">@dateText</span>
    </p>
</header>

@if (Model.Space == TourKeys.Business)
{
    ViewData["Wide"] = true;
    if (Model.Business is { } business)
    {
        <partial name="_BusinessHome" model="business" />
    }
}
else if (Model.Client is { } client)
{
    var steps = new (bool Done, string Label, string Url)[]
    {
        (client.PropertyCount > 0, L["Start_AddHome"].Value, "/logements/nouveau"),
        (client.Subscription?.Status is SubscriptionStatus.Active or SubscriptionStatus.PastDue, L["Start_Activate"].Value, "/abonnement"),
        (client.RequestCount > 0, L["Start_FirstReport"].Value, "/signaler"),
    };
    var done = steps.Count(s => s.Done);

    <div class="mt-6 grid gap-6">
        @if (done < steps.Length && client.ActiveRequest is null)
        {
            <partial name="Ui/_Checklist" model='new ChecklistModel(L["Start_Title"].Value, [.. steps.Select(s => new ChecklistStep(s.Label, s.Url, s.Done))])' />
        }

        @if (client.ActiveRequest is { } active)
        {
            <section aria-labelledby="en-cours-titre">
                <div class="flex items-center justify-between gap-2">
                    <h2 id="en-cours-titre" class="sc-sous-titre">@L["Space_InProgress"]</h2>
                    <a href="/interventions" class="text-sm">@L["Biz_AllRequests"]</a>
                </div>
                <div class="mt-3 grid gap-3">
                    <partial name="Ui/_InterventionCard" model='new InterventionCardModel(active.Number, active.Domain, active.Title, active.Status, active.Urgency, "/interventions/" + active.Id, active.AppointmentAt, active.Technician?.Name, active.Technician?.PhoneE164)' />
                    <div class="sc-carte"><partial name="Ui/_Timeline" model="client.ActiveTimeline" /></div>
                </div>
            </section>
        }

        <div class="grid gap-4 md:grid-cols-2">
            @if (client.Subscription is { } subscription)
            {
                <section class="sc-carte" aria-labelledby="abonnement-titre" data-tour="abonnement">
                    <div class="flex items-center justify-between gap-2">
                        <h2 id="abonnement-titre" class="text-sm font-medium text-charbon-doux">@L["Space_Subscription"]</h2>
                        <span class="sc-badge @SubscriptionBadge(subscription.Status)">@L["SubscriptionStatus_" + subscription.Status]</span>
                    </div>
                    <p class="mt-2 text-[15px] font-medium">@subscription.PlanName</p>
                    <p class="text-sm text-charbon-doux">
                        @if (subscription.NextDueDate is { } due)
                        {
                            @L["Subscription_NextDue", Day(due)]
                        }
                        else
                        {
                            @L["Space_Subscription_Text"]
                        }
                    </p>
                    <a href="/abonnement" class="sc-btn-secondaire mt-3">@(subscription.Status == SubscriptionStatus.PendingRegistration ? L["Pay_Action"] : L["Space_ManageSubscription"])</a>
                </section>
            }

            <section class="sc-carte" aria-labelledby="conseil-titre">
                <h2 id="conseil-titre" class="text-sm font-medium text-charbon-doux">@L["Space_Advice"]</h2>
                <p class="mt-2 text-[15px] font-medium">@(client.Advice?.Title ?? (Model.IsRainySeason ? L["Space_Advice_Rain_Title"] : L["Space_Advice_PreRain_Title"]))</p>
                <p class="mt-1 text-sm text-charbon-doux">@(client.Advice?.Body ?? (Model.IsRainySeason ? L["Space_Advice_Rain_Text"] : L["Space_Advice_PreRain_Text"]))</p>
            </section>
        </div>

        @if (client.Neighborhood is { } hood)
        {
            <partial name="Ui/_NeighborhoodGauge" model="hood" />
        }

        @if (client.Community is { } community && client.Referral is { } referral)
        {
            <partial name="_Community" model="(community, referral)" />
        }
    </div>
}

@functions {
    private static string SubscriptionBadge(SubscriptionStatus status) => status switch
    {
        SubscriptionStatus.Active => "bg-baobab-clair text-baobab",
        SubscriptionStatus.PastDue => "bg-soleil-clair text-soleil",
        SubscriptionStatus.Suspended => "bg-rouge-clair text-rouge",
        _ => "bg-sourdine text-charbon-doux",
    };
}
