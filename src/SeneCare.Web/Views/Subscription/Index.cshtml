@model IReadOnlyList<SeneCare.Application.Subscriptions.SubscriptionSummary>
@using SeneCare.Domain.Billing
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "espace";
    ViewData["Title"] = L["Space_Subscription"];
    var canSimulate = ViewData["CanSimulate"] is true;
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
}

<h1 class="sc-titre">@L["Space_Subscription"]</h1>

@if (Model.Count == 0)
{
    <div class="mt-6">
        <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Space_NoProperty_Title"], L["Subscription_None"], EmptyIllustration.House, L["Property_Add"], "/logements/nouveau")' />
    </div>
}

<div class="mt-6 grid gap-4">
    @foreach (var sub in Model)
    {
        <section class="sc-carte" aria-label="@sub.PlanName">
            <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                    <p class="sc-surtitre">@sub.PlanName</p>
                    <h2 class="font-display text-lg font-bold">@string.Join(", ", sub.PropertyNames)</h2>
                </div>
                <span class="sc-badge @(sub.Status switch { SubscriptionStatus.Active => "bg-baobab-clair text-baobab", SubscriptionStatus.PastDue => "bg-soleil text-charbon", SubscriptionStatus.Suspended => "bg-laterite text-sur-accent", _ => "bg-atlantique-clair text-atlantique" })">@L["SubscriptionStatus_" + sub.Status]</span>
            </div>

            <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                <dt class="text-charbon-doux">@L["Subscription_Monthly"]</dt><dd class="text-right font-bold"><sc-amount value="@sub.MonthlyPrice.Amount" /></dd>
                @if (sub.Status == SubscriptionStatus.PendingRegistration)
                {
                    <dt class="text-charbon-doux">@L["Subscription_Registration"]</dt><dd class="text-right font-bold"><sc-amount value="@sub.RegistrationFee.Amount" /></dd>
                    <dt class="font-bold">@L["Subscription_FirstPayment"]</dt><dd class="text-right font-bold text-laterite"><sc-amount value="@((sub.RegistrationFee + sub.MonthlyPrice * sub.BillingPeriodMonths).Amount)" /></dd>
                }
                @if (sub.CurrentPeriod is { } period)
                {
                    <dt class="text-charbon-doux">@L["Subscription_Period"]</dt><dd class="text-right">@Day(period.Start) – @Day(period.End)</dd>
                }
                @if (sub.NextDueDate is { } due)
                {
                    <dt class="text-charbon-doux">@L["Subscription_NextDueLabel"]</dt><dd class="text-right font-bold">@Day(due)</dd>
                }
            </dl>

            @if (sub.Status == SubscriptionStatus.PendingRegistration)
            {
                <p class="sc-alert mt-4 border-soleil bg-soleil-clair">@L["Subscription_PendingText"]</p>
                @if (canSimulate)
                {
                    <form method="post" asp-action="SimulateActivation" asp-route-id="@sub.Id" class="mt-2">
                        <button type="submit" class="sc-btn-secondaire min-h-10 text-sm">Activer (simulation, développement)</button>
                    </form>
                }
            }

            <h3 class="mt-5 font-bold">@L["Subscription_Invoices"]</h3>
            @if (sub.Invoices.Count == 0)
            {
                <p class="sc-texte-doux mt-1">@L["Subscription_NoInvoice"]</p>
            }
            else
            {
                <ul class="mt-2 divide-y divide-ligne">
                    @foreach (var invoice in sub.Invoices)
                    {
                        <li class="flex items-center justify-between gap-2 py-2">
                            <span><span class="font-bold">@invoice.Number</span><span class="block text-sm text-charbon-doux">@L["Subscription_DueOn", Day(invoice.DueDate)]</span></span>
                            <span class="text-right"><sc-amount value="@invoice.Total.Amount" class="font-bold" /><span class="block text-sm">@L["InvoiceStatus_" + invoice.Status]</span></span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>
