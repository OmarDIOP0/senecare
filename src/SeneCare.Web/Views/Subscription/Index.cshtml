@model IReadOnlyList<SubscriptionPageItem>
@using SeneCare.Domain.Billing
@{
    Layout = "_AppLayout";
    var isBusiness = AppNavigation.IsBusiness(User);
    ViewData["NavActive"] = isBusiness ? "factures" : "espace";
    var title = isBusiness ? L["Tab_Invoices"] : L["Space_Subscription"];
    ViewData["Title"] = title;
    ViewData["Wide"] = true;
    var canSimulate = ViewData["CanSimulate"] is true;
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
    string StatusBadge(SubscriptionStatus s) => s switch
    {
        SubscriptionStatus.Active => "bg-baobab-clair text-baobab",
        SubscriptionStatus.PastDue => "bg-soleil-clair text-soleil",
        SubscriptionStatus.Suspended => "bg-rouge-clair text-rouge",
        _ => "bg-sourdine text-charbon-doux",
    };
    string InvoiceBadge(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Paid => "bg-baobab-clair text-baobab",
        InvoiceStatus.Overdue => "bg-rouge-clair text-rouge",
        InvoiceStatus.Issued => "bg-soleil-clair text-soleil",
        _ => "bg-sourdine text-charbon-doux",
    };
}

<header class="sc-entete">
    <div>
        <h1 class="sc-titre">@title</h1>
        <p>@L["Subscription_Description"]</p>
    </div>
    @if (isBusiness)
    {
        <a href="/entreprise/exports/factures.csv" class="sc-btn-secondaire" download><sc-icon name="receipt" class="size-4" />@L["Export_InvoicesCsv"]</a>
    }
</header>

@if (Model.Count == 0)
{
    <div class="mt-6">
        <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Space_NoProperty_Title"], L["Subscription_None"], EmptyIllustration.House, L["Property_Add"], "/logements/nouveau")' />
    </div>
}

<div class="mt-6 grid gap-8">
    @foreach (var item in Model)
    {
        var sub = item.Subscription;
        var due = item.Due;
        <section aria-label="@sub.PlanName" class="grid gap-4">
            <div class="rounded-lg border border-ligne bg-surface">
                <div class="flex flex-wrap items-start justify-between gap-2 border-b border-ligne px-4 py-3">
                    <div class="min-w-0">
                        <h2 class="text-[15px] font-semibold">@sub.PlanName</h2>
                        <p class="truncate text-[13px] text-charbon-doux">@string.Join(", ", sub.PropertyNames)</p>
                    </div>
                    <span class="sc-badge @StatusBadge(sub.Status)">@L["SubscriptionStatus_" + sub.Status]</span>
                </div>
                <dl class="flex flex-wrap gap-px bg-ligne text-sm">
                    <div class="min-w-40 flex-1 bg-surface px-4 py-3"><dt class="text-[13px] text-charbon-doux">@L["Subscription_Monthly"]</dt><dd class="mt-0.5 font-medium"><sc-amount value="@sub.MonthlyPrice.Amount" /></dd></div>
                    @if (sub.Status == SubscriptionStatus.PendingRegistration)
                    {
                        <div class="min-w-40 flex-1 bg-surface px-4 py-3"><dt class="text-[13px] text-charbon-doux">@L["Subscription_Registration"]</dt><dd class="mt-0.5 font-medium"><sc-amount value="@sub.RegistrationFee.Amount" /></dd></div>
                    }
                    @if (sub.CurrentPeriod is { } period)
                    {
                        <div class="min-w-40 flex-1 bg-surface px-4 py-3"><dt class="text-[13px] text-charbon-doux">@L["Subscription_Period"]</dt><dd class="mt-0.5 font-medium">@Day(period.Start) – @Day(period.End)</dd></div>
                    }
                    @if (sub.NextDueDate is { } nextDue)
                    {
                        <div class="min-w-40 flex-1 bg-surface px-4 py-3"><dt class="text-[13px] text-charbon-doux">@L["Subscription_NextDueLabel"]</dt><dd class="mt-0.5 font-medium">@Day(nextDue)</dd></div>
                    }
                </dl>
            </div>

            @if (due is not null)
            {
                <div class="rounded-lg border border-ligne bg-surface" aria-labelledby="payer-@due.InvoiceId">
                    <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-ligne px-4 py-3">
                        <h3 id="payer-@due.InvoiceId" class="text-sm font-semibold">@(due.IsRegistration ? L["Pay_TitleFirst"] : L["Pay_TitleRenewal"])</h3>
                        <p class="text-[13px] text-charbon-doux">@L["Pay_Invoice", due.Number]</p>
                    </div>
                    <div class="grid gap-4 p-4 md:grid-cols-[1fr_auto]">
                        <div>
                            <p class="text-2xl font-semibold tracking-tight"><sc-amount value="@due.Amount.Amount" /></p>

                            @if (due.Declaration is { Status: PaymentStatus.Pending } pending)
                            {
                                <p class="mt-3 flex items-start gap-2 text-sm text-charbon-doux" role="status">
                                    <sc-icon name="clock" class="mt-0.5 size-4" />
                                    <span>@L["Pay_Verifying", Formatting.ShortDateTime(pending.DeclaredAt)]</span>
                                </p>
                            }
                            else
                            {
                                @if (due.Declaration is { Status: PaymentStatus.Failed } rejected)
                                {
                                    <p class="mt-3 rounded-md bg-rouge-clair px-3 py-2 text-sm text-rouge" role="alert">@L["Pay_Rejected", rejected.RejectionReason ?? string.Empty]</p>
                                }

                                @if (due.WaveUrl is { } waveUrl)
                                {
                                    <ol class="mt-3 grid gap-1.5 text-sm text-charbon-doux">
                                        <li class="flex gap-2"><span class="w-4 shrink-0 text-charbon-pale tabular-nums">1.</span><span>@L["Pay_Step1"]</span></li>
                                        <li class="flex gap-2"><span class="w-4 shrink-0 text-charbon-pale tabular-nums">2.</span><span>@L["Pay_Step2", due.Number]</span></li>
                                        <li class="flex gap-2"><span class="w-4 shrink-0 text-charbon-pale tabular-nums">3.</span><span>@L["Pay_Step3"]</span></li>
                                    </ol>
                                    <div class="mt-4 flex flex-wrap gap-2">
                                        <a href="@waveUrl" class="sc-btn-primaire" rel="noopener" target="_blank"><sc-icon name="wallet" class="size-4" />@L["Pay_WithWave"]</a>
                                    </div>
                                    <form method="post" asp-action="DeclarePayment" asp-route-invoiceId="@due.InvoiceId" class="mt-4 flex flex-wrap items-end gap-2 border-t border-ligne pt-4">
                                        <div class="min-w-56 flex-1">
                                            <label class="sc-label" for="ref-@due.InvoiceId">@L["Pay_Reference"]</label>
                                            <input id="ref-@due.InvoiceId" name="reference" class="sc-input" autocomplete="off" placeholder="@L["Pay_Reference_Placeholder"]" />
                                        </div>
                                        <button type="submit" class="sc-btn-secondaire"><sc-icon name="check" class="size-4" />@L["Pay_Declare"]</button>
                                    </form>
                                    <p class="sc-aide">@L["Pay_Reference_Hint"]</p>
                                }
                                else
                                {
                                    <p class="mt-3 text-sm text-charbon-doux">@L["Pay_NotConfigured"]</p>
                                }
                            }
                        </div>
                        @if (item.QrSvg is not null && due.Declaration is not { Status: PaymentStatus.Pending })
                        {
                            <figure class="hidden w-40 rounded-md border border-ligne bg-white p-2 md:block">
                                @Html.Raw(item.QrSvg)
                                <figcaption class="mt-1 text-center text-xs text-charbon-doux">@L["Pay_ScanQr"]</figcaption>
                            </figure>
                        }
                    </div>
                </div>
            }

            @if (sub.Status == SubscriptionStatus.PendingRegistration && canSimulate)
            {
                <form method="post" asp-action="SimulateActivation" asp-route-id="@sub.Id">
                    <button type="submit" class="sc-btn-discret">Activer (simulation, développement)</button>
                </form>
            }

            <div>
                <h3 class="sc-sous-titre">@L["Subscription_Invoices"]</h3>
                @if (sub.Invoices.Count == 0)
                {
                    <p class="mt-1 text-sm text-charbon-doux">@L["Subscription_NoInvoice"]</p>
                }
                else
                {
                    <div class="mt-3 hidden overflow-x-auto rounded-lg border border-ligne bg-surface sm:block">
                        <table class="sc-table">
                            <thead>
                                <tr>
                                    <th scope="col">@L["Export_Col_Invoice"]</th>
                                    <th scope="col">@L["Export_Col_DueDate"]</th>
                                    <th scope="col" class="text-right">@L["Invoice_Col_Amount"]</th>
                                    <th scope="col">@L["Export_Col_Status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in sub.Invoices)
                                {
                                    <tr>
                                        <td class="font-medium">@invoice.Number</td>
                                        <td class="text-charbon-doux">@Day(invoice.DueDate)</td>
                                        <td class="text-right"><sc-amount value="@invoice.Total.Amount" /></td>
                                        <td><span class="sc-badge @InvoiceBadge(invoice.Status)">@L["InvoiceStatus_" + invoice.Status]</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <ul class="mt-3 divide-y divide-ligne rounded-lg border border-ligne bg-surface sm:hidden">
                        @foreach (var invoice in sub.Invoices)
                        {
                            <li class="flex items-center justify-between gap-3 px-3 py-2.5">
                                <div class="min-w-0">
                                    <p class="font-medium"><sc-amount value="@invoice.Total.Amount" /></p>
                                    <p class="text-[13px] text-charbon-doux">@invoice.Number · @Day(invoice.DueDate)</p>
                                </div>
                                <span class="sc-badge shrink-0 @InvoiceBadge(invoice.Status)">@L["InvoiceStatus_" + invoice.Status]</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    }
</div>
