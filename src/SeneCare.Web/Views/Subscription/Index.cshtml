@model IReadOnlyList<SubscriptionPageItem>
@using SeneCare.Domain.Billing
@{
    Layout = "_AppLayout";
    var isBusiness = AppNavigation.IsBusiness(User);
    ViewData["NavActive"] = isBusiness ? "factures" : "abonnement";
    var title = isBusiness ? L["Tab_Invoices"] : L["Space_Subscription"];
    ViewData["Title"] = title;
    ViewData["Wide"] = true;
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
    (string Badge, string Dot) Status(SubscriptionStatus s) => s switch
    {
        SubscriptionStatus.Active => ("bg-baobab-clair text-baobab", "bg-baobab"),
        SubscriptionStatus.PastDue => ("bg-soleil-clair text-soleil", "bg-soleil"),
        SubscriptionStatus.Suspended => ("bg-rouge-clair text-rouge", "bg-rouge"),
        _ => ("bg-ambre text-nuit", "bg-nuit"),
    };
    string InvoiceBadge(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Paid => "bg-baobab-clair text-baobab",
        InvoiceStatus.Overdue => "bg-rouge-clair text-rouge",
        InvoiceStatus.Issued => "bg-soleil-clair text-soleil",
        _ => "bg-sourdine text-charbon-doux",
    };
}

<header class="sc-entete">
    <div>
        <p class="sc-eyebrow">@L["Subscription_Eyebrow"]</p>
        <h1 class="sc-titre mt-2">@title</h1>
        <p>@L["Subscription_Description"]</p>
    </div>
    @if (isBusiness)
    {
        <a href="/entreprise/exports/factures.csv" class="sc-btn-secondaire" download><sc-icon name="download" class="size-4" />@L["Export_InvoicesCsv"]</a>
    }
</header>

@if (Model.Count == 0)
{
    <div class="mt-6">
        <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Space_NoProperty_Title"], L["Subscription_None"], EmptyIllustration.House, L["Property_Add"], "/logements/nouveau")' />
    </div>
}

<div class="mt-8 grid gap-10">
    @foreach (var item in Model)
    {
        var sub = item.Subscription;
        var due = item.Due;
        var look = Status(sub.Status);
        var pending = due?.Declaration is { Status: PaymentStatus.Pending };
        // Where the customer is in « inscription → paiement → vérification → actif ».
        var stage = sub.Status != SubscriptionStatus.PendingRegistration ? 3 : pending ? 2 : 1;
        <section aria-label="@sub.PlanName" class="grid gap-6">

            @* ---- The plan (dark Atlantic panel) + where it stands ---- *@
            <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr]">
                <div class="sc-panneau relative overflow-hidden p-6 sm:p-8">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <p class="font-mono text-xs font-bold tracking-[0.16em] text-or uppercase">@L["Subscription_YourPlan"]</p>
                        <span class="sc-badge @look.Badge"><span class="size-1.5 rounded-full @look.Dot"></span>@L["SubscriptionStatus_" + sub.Status]</span>
                    </div>
                    <h2 class="mt-3 font-display text-2xl leading-tight tracking-[-0.02em] sm:text-3xl">@sub.PlanName</h2>
                    <p class="mt-1 text-sur-nuit/75">@string.Join(" · ", sub.PropertyNames)</p>
                    <div class="mt-6 flex flex-wrap items-end gap-x-3 gap-y-1">
                        @if (sub.IsAnnual)
                        {
                            <span class="font-display text-3xl text-white sm:text-4xl"><sc-amount value="@sub.PeriodPrice.Amount" /></span>
                            <span class="pb-1 text-sur-nuit/75">@L["Register_PerYear"]</span>
                            @if (sub.FreeMonthsPerPeriod > 0)
                            {
                                <span class="sc-badge mb-1.5 bg-ambre text-nuit">@L["Register_FreeMonths", sub.FreeMonthsPerPeriod]</span>
                            }
                        }
                        else
                        {
                            <span class="font-display text-3xl text-white sm:text-4xl"><sc-amount value="@sub.MonthlyPrice.Amount" /></span>
                            <span class="pb-1 text-sur-nuit/75">@L["Home_Offer_PerMonth"]@(sub.BillingPeriodMonths > 1 ? " · " + L["Subscription_BilledEvery", sub.BillingPeriodMonths] : "")</span>
                        }
                    </div>
                    <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-white/10 pt-5 text-sm">
                        <div>
                            <dt class="font-mono text-[10px] tracking-[0.12em] text-sur-nuit/60 uppercase">@L["Subscription_Period"]</dt>
                            <dd class="mt-1 font-semibold text-white">@(sub.CurrentPeriod is { } period ? (sub.IsAnnual ? $"{Formatting.DateWithYear(period.Start)} – {Formatting.DateWithYear(period.End)}" : $"{Day(period.Start)} – {Day(period.End)}") : L["Subscription_NotStarted"])</dd>
                        </div>
                        <div>
                            <dt class="font-mono text-[10px] tracking-[0.12em] text-sur-nuit/60 uppercase">@L["Subscription_NextDueLabel"]</dt>
                            <dd class="mt-1 font-semibold text-white">@(sub.NextDueDate is { } next ? (sub.IsAnnual ? Formatting.DateWithYear(next) : Day(next)) : "—")</dd>
                        </div>
                    </dl>
                    <div class="sc-bande-fine absolute inset-x-0 bottom-0"></div>
                </div>

                <div class="rounded-3xl border border-ligne bg-surface p-6 shadow-carte sm:p-8">
                    <p class="sc-eyebrow">@L["Subscription_Progress"]</p>
                    <ol class="mt-5 grid gap-4">
                        @foreach (var (index, (icon, key)) in new[] { ("user-check", "Subscription_Stage1"), ("wallet", "Subscription_Stage2"), ("hourglass", "Subscription_Stage3"), ("seal-check", "Subscription_Stage4") }.Index())
                        {
                            var done = index < stage || stage == 3;
                            var current = index == stage && stage < 3;
                            <li class="flex items-start gap-3">
                                <span class="grid size-10 shrink-0 place-items-center rounded-full @(done ? "bg-baobab text-white" : current ? "bg-ambre text-nuit ring-4 ring-ambre/25" : "bg-sourdine text-charbon-pale")">
                                    <sc-icon name="@(done ? "check" : icon)" class="size-5" />
                                </span>
                                <span class="pt-2 @(current ? "font-bold" : done ? "" : "text-charbon-doux")">@L[key]</span>
                            </li>
                        }
                    </ol>
                </div>
            </div>

            @* ---- What is due now: Wave or Orange Money, as the admin opened them; the customer chooses ---- *@
            @if (due is not null)
            {
                var channels = due.Channels;
                var choose = channels.Count > 1;
                // With two ways to pay, each panel shows when its radio is ticked (no script).
                // Class names written out in full: Tailwind only builds the ones it reads in the source.
                string Panel(PaymentChannel channel) => !choose
                    ? "grid"
                    : channel == PaymentChannel.Wave
                        ? "hidden [.sc-pay:has(input[name=channel][value=Wave]:checked)_&]:grid"
                        : "hidden [.sc-pay:has(input[name=channel][value=OrangeMoney]:checked)_&]:grid";
                <div class="sc-pay overflow-hidden rounded-3xl border border-ligne bg-surface shadow-carte" aria-labelledby="payer-@due.InvoiceId">
                    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-ligne bg-sourdine/60 px-6 py-4 sm:px-8">
                        <div class="flex items-center gap-3">
                            <span class="grid size-11 place-items-center rounded-xl bg-surface text-laterite [--icon-fond:var(--ambre)]"><sc-icon name="wallet" class="size-6" /></span>
                            <div>
                                <h3 id="payer-@due.InvoiceId" class="text-lg">@(!due.IsRegistration ? L["Pay_TitleRenewal"] : sub.BillingPeriodMonths > 1 ? L["Pay_TitleFirstPeriod", sub.BillingPeriodMonths] : L["Pay_TitleFirst"])</h3>
                                <p class="text-sm text-charbon-doux">@L["Pay_Invoice", due.Number]</p>
                            </div>
                        </div>
                        <p class="font-display text-2xl sm:text-3xl"><sc-amount value="@due.Amount.Amount" /></p>
                    </div>

                    <div class="grid gap-6 p-6 sm:p-8 md:grid-cols-[1fr_auto]">
                        <div>
                            @if (pending)
                            {
                                <div class="flex items-start gap-4 rounded-2xl bg-ocre-clair p-5" role="status">
                                    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-surface text-ocre-texte"><sc-icon name="hourglass" class="size-6 motion-safe:animate-pulse" /></span>
                                    <div>
                                        <p class="text-lg font-bold">@L["Pay_PendingTitle"]</p>
                                        <p class="mt-1 text-[15px] text-charbon-doux">@L["Pay_Verifying", Formatting.ShortDateTime(due.Declaration!.DeclaredAt)]</p>
                                        <p class="mt-2 flex items-center gap-1.5 text-sm font-semibold text-baobab"><sc-icon name="clock" class="size-4" />@L["Pay_PendingNotice"]</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (due.Declaration is { Status: PaymentStatus.Failed } rejected)
                                {
                                    <p class="mb-4 flex items-start gap-2 rounded-2xl bg-rouge-clair px-4 py-3 text-sm text-rouge" role="alert"><sc-icon name="triangle-alert" class="mt-0.5 size-4" />@L["Pay_Rejected", rejected.RejectionReason ?? string.Empty]</p>
                                }

                                @if (channels.Count > 0)
                                {
                                    <form method="post" asp-action="DeclarePayment" asp-route-invoiceId="@due.InvoiceId" class="grid gap-6">
                                        @if (choose)
                                        {
                                            <fieldset>
                                                <legend class="sc-label-mono">@L["Pay_Choose"]</legend>
                                                <div class="mt-2 grid grid-cols-2 gap-3">
                                                    @foreach (var (index, channel) in channels.Index())
                                                    {
                                                        <label class="flex min-h-14 min-w-0 cursor-pointer items-center gap-2 rounded-2xl border border-ligne bg-surface px-3 py-2 font-semibold transition-colors hover:border-charbon/25 has-checked:border-ambre has-checked:bg-ocre-clair has-checked:ring-2 has-checked:ring-ambre/50 has-focus-visible:outline-2 has-focus-visible:outline-laterite">
                                                            <input type="radio" name="channel" value="@channel" class="size-4 accent-laterite" checked="@(index == 0)" />
                                                            <img src="@(channel == PaymentChannel.Wave ? "/images/wave-logo.webp" : "/images/orange-money-logo.webp")" alt="" width="32" height="32" class="size-8 rounded-lg" />
                                                            <span class="min-w-0 leading-tight">@L["Channel_" + channel]</span>
                                                        </label>
                                                    }
                                                </div>
                                            </fieldset>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="channel" value="@channels[0]" />
                                        }

                                        @if (due.WaveUrl is { } waveUrl)
                                        {
                                            <div class="@Panel(PaymentChannel.Wave) gap-6">
                                                <ol class="grid gap-3">
                                                    @foreach (var (index, text) in new[] { L["Pay_Step1"].Value, L["Pay_Step2", due.Number].Value, L["Pay_Step3"].Value }.Index())
                                                    {
                                                        <li class="flex items-start gap-3">
                                                            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#1dc8ff]/15 font-mono text-sm font-bold text-[#0a6b8a] dark:text-[#7fdcff]">@(index + 1)</span>
                                                            <span class="pt-1 text-[15px]">@text</span>
                                                        </li>
                                                    }
                                                </ol>
                                                <a href="@waveUrl" class="sc-btn min-h-12 w-full bg-[#1dc8ff] px-6 text-base text-[#04212b] hover:brightness-95 sm:w-auto sm:justify-self-start" rel="noopener" target="_blank">
                                                    <img src="~/images/wave-logo.webp" alt="" width="24" height="24" class="size-6 rounded-md" />@L["Pay_WithWave"]
                                                </a>
                                            </div>
                                        }

                                        @if (channels.Contains(PaymentChannel.OrangeMoney))
                                        {
                                            var omSteps = new List<string>
                                            {
                                                due.OrangeMoneyCode is not null ? L["Pay_Om_Step1"].Value : L["Pay_Om_Step1_Link"].Value,
                                            };
                                            if (due.OrangeMoneyCode is { } omCode)
                                            {
                                                omSteps.Add(L["Pay_Om_Step2", Formatting.Fcfa(due.Amount), omCode].Value);
                                            }

                                            omSteps.Add(L["Pay_Om_Step3"].Value);
                                            omSteps.Add(L["Pay_Step3"].Value);
                                            <div class="@Panel(PaymentChannel.OrangeMoney) gap-6">
                                                <ol class="grid gap-3">
                                                    @foreach (var (index, text) in omSteps.Index())
                                                    {
                                                        <li class="flex items-start gap-3">
                                                            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-sourdine font-mono text-sm font-bold text-charbon">@(index + 1)</span>
                                                            <span class="pt-1 text-[15px]">@text</span>
                                                        </li>
                                                    }
                                                </ol>
                                                <p class="flex flex-wrap gap-3">
                                                    @if (due.OrangeMoneyCode is not null)
                                                    {
                                                        @* Opens the phone's Orange Money menu (useless on a computer: hidden there). *@
                                                        <a href="tel:%23144%23" class="sc-btn-secondaire min-h-12 md:hidden"><sc-icon name="phone" class="size-5 text-laterite" />@L["Pay_DialOrange"]</a>
                                                    }
                                                    @if (due.OrangeMoneyUrl is { } omUrl)
                                                    {
                                                        <a href="@omUrl" class="sc-btn-secondaire min-h-12" rel="noopener" target="_blank"><img src="~/images/orange-money-logo.webp" alt="" width="24" height="24" class="size-6 rounded-md" />@L["Pay_WithOrange"]</a>
                                                    }
                                                </p>
                                            </div>
                                        }

                                        <div class="grid gap-3 rounded-2xl border border-dashed border-ligne p-4 sm:grid-cols-[1fr_auto] sm:items-end">
                                            <div>
                                                <label class="sc-label-mono" for="ref-@due.InvoiceId">@L["Pay_Reference"]</label>
                                                <input id="ref-@due.InvoiceId" name="reference" class="sc-input" autocomplete="off" maxlength="100" placeholder="@L["Pay_Reference_Placeholder"]" aria-describedby="ref-aide-@due.InvoiceId" />
                                            </div>
                                            <button type="submit" class="sc-btn-primaire min-h-12"><sc-icon name="check" class="size-4" />@L["Pay_Declare"]</button>
                                            <p id="ref-aide-@due.InvoiceId" class="sc-aide sm:col-span-2">@L["Pay_Reference_Hint"]</p>
                                        </div>
                                    </form>
                                }
                                else
                                {
                                    @* Nothing opened yet (an admin sets it in Admin › Paiements): never a dead end, the customer can write to us. *@
                                    <p class="flex items-start gap-2 rounded-2xl bg-sourdine px-4 py-3 text-[15px] text-charbon-doux"><sc-icon name="info" class="mt-0.5 size-5" />@L["Pay_NotConfigured"]</p>
                                    @if ((await SiteContact.GetAsync()).WhatsAppUrl is { } help)
                                    {
                                        <a href="@help" class="sc-btn-whatsapp mt-4 min-h-12 w-full sm:w-auto" target="_blank" rel="noopener"><sc-icon name="message-circle" />@L["Pay_AskOnWhatsApp"]</a>
                                    }
                                }
                            }
                        </div>
                        @if (item.QrSvg is not null && !pending)
                        {
                            @* The Wave QR code, only while Wave is the chosen way to pay. *@
                            <figure class="hidden w-44 self-start rounded-2xl border border-ligne bg-white p-3 md:block @(choose ? "[.sc-pay:has(input[name=channel][value=OrangeMoney]:checked)_&]:hidden" : "")">
                                @Html.Raw(item.QrSvg)
                                <figcaption class="mt-2 text-center text-xs font-semibold text-charbon-doux">@L["Pay_ScanQr"]</figcaption>
                            </figure>
                        }
                    </div>
                </div>
            }

            @* ---- « Changer de formule »: from the next period on (no refund, no recalculation of the current one) ---- *@
            @if (item.Offer is { } offer)
            {
                var anchor = "formule-" + sub.Id.ToString("N");
                <details id="@anchor" class="group rounded-3xl border border-ligne bg-surface shadow-carte" open="@(offer.NextCode is not null)">
                    <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-3 px-6 py-5 sm:px-8 [&::-webkit-details-marker]:hidden">
                        <span>
                            <span class="block font-semibold">@L["Offer_Change_Title"]</span>
                            <span class="mt-0.5 block text-sm text-charbon-doux">@L["Offer_Change_Text", offer.StartsOn is { } starts ? Formatting.DateWithYear(starts) : "—"]</span>
                        </span>
                        <sc-icon name="chevron-down" class="size-5 text-charbon-doux transition-transform group-open:rotate-180" />
                    </summary>
                    <div class="border-t border-ligne px-6 py-5 sm:px-8">
                        @if (offer.NextName is { } nextName)
                        {
                            <div class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-ocre-clair p-4">
                                <p class="text-[15px] font-semibold">@L["Offer_Change_Planned", nextName + (offer.NextAnnual ? " · " + L["Offer_Change_Yearly"].Value : ""), offer.StartsOn is { } on ? Formatting.DateWithYear(on) : "—"]</p>
                                <form method="post" action="/abonnement/@sub.Id/formule/annuler">
                                    <button type="submit" class="sc-btn-secondaire">@L["Offer_Change_Withdraw"]</button>
                                </form>
                            </div>
                        }
                        <form method="post" action="/abonnement/@sub.Id/formule" class="grid gap-4">
                            <fieldset class="grid gap-2 sm:grid-cols-2">
                                <legend class="sr-only">@L["Offer_Change_Title"]</legend>
                                @foreach (var choice in offer.Choices)
                                {
                                    var selected = choice.Code == (offer.NextCode ?? offer.CurrentCode);
                                    <label class="flex cursor-pointer items-start gap-3 rounded-2xl border border-ligne p-4 has-[:checked]:border-laterite has-[:checked]:bg-ocre-clair">
                                        <input type="radio" name="plan" value="@choice.Code" checked="@selected" class="mt-1 accent-[var(--laterite)]" required />
                                        <span>
                                            <span class="block font-semibold">@choice.Name@(choice.Code == offer.CurrentCode ? " · " + L["Offer_Change_Current"].Value : "")</span>
                                            <span class="block text-sm text-charbon-doux"><sc-amount value="@choice.MonthlyPrice.Amount" /> @L["Home_Offer_PerMonth"]@(choice.BillingPeriodMonths > 1 ? " · " + L["Subscription_BilledEvery", choice.BillingPeriodMonths] : "")</span>
                                        </span>
                                    </label>
                                }
                            </fieldset>
                            @if (offer.Choices.FirstOrDefault(c => c.OffersAnnual) is { } yearly)
                            {
                                var annualNow = offer.NextCode is not null ? offer.NextAnnual : offer.CurrentAnnual;
                                <label class="flex cursor-pointer items-center gap-3 text-[15px]">
                                    <input type="checkbox" name="annual" value="true" checked="@annualNow" class="size-5 accent-[var(--laterite)]" />
                                    <span>@L["Offer_Change_Annual", yearly.AnnualFreeMonths]</span>
                                </label>
                            }
                            <div><button type="submit" class="sc-btn-primaire">@L["Offer_Change_Submit"]</button></div>
                        </form>
                    </div>
                </details>
            }

            @* ---- Invoices and receipts ---- *@
            <div>
                <h3 class="sc-sous-titre">@L["Subscription_Invoices"]</h3>
                @if (sub.Invoices.Count == 0)
                {
                    <p class="mt-1 text-sm text-charbon-doux">@L["Subscription_NoInvoice"]</p>
                }
                else
                {
                    <div class="mt-3 hidden overflow-x-auto rounded-2xl border border-ligne bg-surface sm:block">
                        <table class="sc-table">
                            <thead>
                                <tr>
                                    <th scope="col">@L["Export_Col_Invoice"]</th>
                                    <th scope="col">@L["Export_Col_DueDate"]</th>
                                    <th scope="col" class="text-right">@L["Invoice_Col_Amount"]</th>
                                    <th scope="col">@L["Export_Col_Status"]</th>
                                    <th scope="col"><span class="sr-only">PDF</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in sub.Invoices)
                                {
                                    <tr>
                                        <td class="font-semibold">@invoice.Number</td>
                                        <td class="text-charbon-doux">@Day(invoice.DueDate)</td>
                                        <td class="text-right"><sc-amount value="@invoice.Total.Amount" /></td>
                                        <td><span class="sc-badge @InvoiceBadge(invoice.Status)">@L["InvoiceStatus_" + invoice.Status]</span></td>
                                        <td class="text-right">
                                            <a href="/abonnement/factures/@(invoice.Id).pdf" class="inline-flex items-center gap-1.5 text-sm font-semibold">
                                                <sc-icon name="download" class="size-4" />@(invoice.Status == InvoiceStatus.Paid ? L["Subscription_Receipt"] : L["Subscription_InvoicePdf"])
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <ul class="mt-3 divide-y divide-ligne rounded-2xl border border-ligne bg-surface sm:hidden">
                        @foreach (var invoice in sub.Invoices)
                        {
                            <li class="flex items-center justify-between gap-3 px-4 py-3">
                                <div class="min-w-0">
                                    <p class="font-semibold"><sc-amount value="@invoice.Total.Amount" /></p>
                                    <p class="text-sm text-charbon-doux">@invoice.Number · @Day(invoice.DueDate)</p>
                                    <a href="/abonnement/factures/@(invoice.Id).pdf" class="sc-tap mt-1 inline-flex items-center gap-1 text-sm font-semibold"><sc-icon name="download" class="size-4" />@(invoice.Status == InvoiceStatus.Paid ? L["Subscription_Receipt"] : L["Subscription_InvoicePdf"])</a>
                                </div>
                                <span class="sc-badge shrink-0 @InvoiceBadge(invoice.Status)">@L["InvoiceStatus_" + invoice.Status]</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    }
</div>
