@model IReadOnlyList<SubscriptionPageItem>
@using SeneCare.Domain.Billing
@{
    Layout = "_AppLayout";
    var isBusiness = AppNavigation.IsBusiness(User);
    ViewData["NavActive"] = isBusiness ? "factures" : "espace";
    ViewData["Title"] = L["Space_Subscription"];
    var canSimulate = ViewData["CanSimulate"] is true;
    string Day(DateOnly d) => Formatting.ShortDate(new DateTimeOffset(d.ToDateTime(TimeOnly.MinValue), TimeSpan.Zero));
}

<div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="sc-titre">@L["Space_Subscription"]</h1>
    @if (isBusiness)
    {
        <a href="/entreprise/exports/factures.csv" class="sc-btn-secondaire min-h-10 text-sm" download><sc-icon name="receipt" />@L["Export_InvoicesCsv"]</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="mt-6">
        <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Space_NoProperty_Title"], L["Subscription_None"], EmptyIllustration.House, L["Property_Add"], "/logements/nouveau")' />
    </div>
}

<div class="mt-6 grid gap-6">
    @foreach (var item in Model)
    {
        var sub = item.Subscription;
        var due = item.Due;
        <section class="sc-carte" aria-label="@sub.PlanName">
            <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                    <p class="sc-surtitre">@sub.PlanName</p>
                    <h2 class="font-display text-lg font-bold">@string.Join(", ", sub.PropertyNames)</h2>
                </div>
                <span class="sc-badge @(sub.Status switch { SubscriptionStatus.Active => "bg-baobab-clair text-baobab", SubscriptionStatus.PastDue => "bg-soleil text-charbon", SubscriptionStatus.Suspended => "bg-laterite text-sur-accent", _ => "bg-atlantique-clair text-atlantique" })">@L["SubscriptionStatus_" + sub.Status]</span>
            </div>

            <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
                <dt class="text-charbon-doux">@L["Subscription_Monthly"]</dt><dd class="text-right font-bold"><sc-amount value="@sub.MonthlyPrice.Amount" /></dd>
                @if (sub.Status == SubscriptionStatus.PendingRegistration)
                {
                    <dt class="text-charbon-doux">@L["Subscription_Registration"]</dt><dd class="text-right font-bold"><sc-amount value="@sub.RegistrationFee.Amount" /></dd>
                }
                @if (sub.CurrentPeriod is { } period)
                {
                    <dt class="text-charbon-doux">@L["Subscription_Period"]</dt><dd class="text-right">@Day(period.Start) – @Day(period.End)</dd>
                }
                @if (sub.NextDueDate is { } nextDue)
                {
                    <dt class="text-charbon-doux">@L["Subscription_NextDueLabel"]</dt><dd class="text-right font-bold">@Day(nextDue)</dd>
                }
            </dl>

            @if (due is not null)
            {
                <div class="mt-5 rounded-md border-2 border-ligne bg-sable p-4" aria-labelledby="payer-@due.InvoiceId">
                    <h3 id="payer-@due.InvoiceId" class="font-bold">@(due.IsRegistration ? L["Pay_TitleFirst"] : L["Pay_TitleRenewal"])</h3>
                    <p class="mt-1 font-display text-3xl font-bold text-laterite"><sc-amount value="@due.Amount.Amount" /></p>
                    <p class="sc-texte-doux">@L["Pay_Invoice", due.Number]</p>

                    @if (due.Declaration is { Status: PaymentStatus.Pending } pending)
                    {
                        <p class="sc-alert mt-4 flex items-start gap-2 border-atlantique bg-atlantique-clair" role="status">
                            <sc-icon name="clock" class="mt-1 text-atlantique" />
                            <span>@L["Pay_Verifying", Formatting.ShortDateTime(pending.DeclaredAt)]</span>
                        </p>
                    }
                    else
                    {
                        @if (due.Declaration is { Status: PaymentStatus.Failed } rejected)
                        {
                            <p class="sc-alert mt-4 border-laterite bg-laterite-clair" role="alert">@L["Pay_Rejected", rejected.RejectionReason ?? string.Empty]</p>
                        }

                        @if (due.WaveUrl is { } waveUrl)
                        {
                            <ol class="mt-4 grid gap-3 text-sm">
                                <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-laterite font-bold text-sur-accent">1</span><span>@L["Pay_Step1"]</span></li>
                                <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-laterite font-bold text-sur-accent">2</span><span>@L["Pay_Step2", due.Number]</span></li>
                                <li class="flex gap-3"><span class="grid size-7 shrink-0 place-items-center rounded-full bg-laterite font-bold text-sur-accent">3</span><span>@L["Pay_Step3"]</span></li>
                            </ol>

                            <a href="@waveUrl" class="sc-btn mt-4 w-full bg-[#1dc8ff] text-charbon hover:opacity-90" rel="noopener" target="_blank">
                                <sc-icon name="wallet" />@L["Pay_WithWave"]
                            </a>

                            @if (item.QrSvg is not null)
                            {
                                <details class="mt-3">
                                    <summary class="cursor-pointer text-sm font-bold text-atlantique">@L["Pay_ScanQr"]</summary>
                                    <figure class="mx-auto mt-3 w-48 rounded-md bg-white p-2">
                                        @Html.Raw(item.QrSvg)
                                        <figcaption class="sr-only">@L["Pay_ScanQr"]</figcaption>
                                    </figure>
                                </details>
                            }

                            <form method="post" asp-action="DeclarePayment" asp-route-invoiceId="@due.InvoiceId" class="mt-5 grid gap-3 border-t border-dashed border-ligne pt-4">
                                <div>
                                    <label class="sc-label" for="ref-@due.InvoiceId">@L["Pay_Reference"]</label>
                                    <input id="ref-@due.InvoiceId" name="reference" class="sc-input" autocomplete="off" placeholder="@L["Pay_Reference_Placeholder"]" />
                                    <p class="sc-aide">@L["Pay_Reference_Hint"]</p>
                                </div>
                                <button type="submit" class="sc-btn-primaire"><sc-icon name="check" />@L["Pay_Declare"]</button>
                            </form>
                        }
                        else
                        {
                            <p class="sc-alert mt-4 border-soleil bg-soleil-clair">@L["Pay_NotConfigured"]</p>
                        }
                    }
                </div>
            }

            @if (sub.Status == SubscriptionStatus.PendingRegistration && canSimulate)
            {
                <form method="post" asp-action="SimulateActivation" asp-route-id="@sub.Id" class="mt-3">
                    <button type="submit" class="sc-btn-secondaire min-h-10 text-sm">Activer (simulation, développement)</button>
                </form>
            }

            <h3 class="mt-5 font-bold">@L["Subscription_Invoices"]</h3>
            @if (sub.Invoices.Count == 0)
            {
                <p class="sc-texte-doux mt-1">@L["Subscription_NoInvoice"]</p>
            }
            else
            {
                <ul class="mt-2 divide-y divide-ligne">
                    @foreach (var invoice in sub.Invoices)
                    {
                        <li class="flex items-center justify-between gap-2 py-2">
                            <span><span class="font-bold">@invoice.Number</span><span class="block text-sm text-charbon-doux">@L["Subscription_DueOn", Day(invoice.DueDate)]</span></span>
                            <span class="text-right"><sc-amount value="@invoice.Total.Amount" class="font-bold" /><span class="block text-sm">@L["InvoiceStatus_" + invoice.Status]</span></span>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>
