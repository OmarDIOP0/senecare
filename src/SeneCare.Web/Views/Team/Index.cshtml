@model TeamViewModel
@using SeneCare.Domain.Accounts
@using SeneCare.Application.Users
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "equipe";
    ViewData["Title"] = L["Team_Title"];
    ViewData["Wide"] = true;
    var invitePhone = new PhoneInputModel("Invite.Phone", Model.Invite.Phone, L["SignIn_PhoneLabel"], ViewData.ModelState["Invite.Phone"]?.Errors.FirstOrDefault()?.ErrorMessage);
    var siteNames = Model.Sites.ToDictionary(s => s.Id, s => s.Name);
    var roles = new[] { AccountRole.Reporter, AccountRole.SiteManager, AccountRole.Manager };
    string Sites(TeamMemberDto m) => m.Role is AccountRole.SiteManager or AccountRole.Reporter
        ? string.Join(", ", m.SiteIds.Where(siteNames.ContainsKey).Select(id => siteNames[id]))
        : L["Team_AllSites"].Value;
}

<partial name="Ui/_PageHeader" model='new PageHeaderModel(L["Team_Title"].Value, L["Team_Description", Model.AccountName].Value, L["Team_Invite"].Value, "#inviter", "users")' />

@if (TempData["flash.success"] is string invited)
{
    <p class="sc-alert mt-4" role="status">@L["Team_InviteSent", invited]</p>
}

<div class="mt-6 hidden overflow-x-auto rounded-lg border border-ligne bg-surface md:block">
    <table class="sc-table">
        <thead>
            <tr>
                <th scope="col" data-sort>@L["Team_Col_Name"]</th>
                <th scope="col">@L["SignIn_PhoneLabel"]</th>
                <th scope="col" data-sort>@L["Team_RoleLabel"]</th>
                <th scope="col">@L["Team_Sites"]</th>
                <th scope="col"><span class="sr-only">@L["Sites_Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in Model.Members)
            {
                var isMe = member.UserId == Model.CurrentUserId;
                <tr>
                    <td class="font-medium">@(member.FullName ?? "—") @if (isMe) { <span class="font-normal text-charbon-doux">(@L["Team_You"])</span> }</td>
                    <td class="text-charbon-doux tabular-nums">+221 @member.Phone</td>
                    <td><span class="sc-badge bg-sourdine text-charbon-doux">@L["Role_" + member.Role]</span></td>
                    <td class="max-w-64 truncate text-charbon-doux">@Sites(member)</td>
                    <td class="w-10 text-right">
                        @if (!isMe)
                        {
                            <button type="button" class="sc-btn-icone size-8" data-sheet-open="membre-@member.UserId" aria-label="@L["Team_Edit"] — @(member.FullName ?? member.Phone)"><sc-icon name="ellipsis" class="size-4" /></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<ul class="mt-6 grid gap-2 md:hidden">
    @foreach (var member in Model.Members)
    {
        var isMe = member.UserId == Model.CurrentUserId;
        <li class="sc-carte flex items-center gap-3 px-3 py-2.5">
            <div class="min-w-0 flex-1">
                <p class="font-medium">@(member.FullName ?? "—") @if (isMe) { <span class="font-normal text-charbon-doux">(@L["Team_You"])</span> }</p>
                <p class="text-[13px] text-charbon-doux">@L["Role_" + member.Role] · +221 @member.Phone</p>
            </div>
            @if (!isMe)
            {
                <button type="button" class="sc-btn-icone" data-sheet-open="membre-@member.UserId" aria-label="@L["Team_Edit"]"><sc-icon name="ellipsis" class="size-4" /></button>
            }
        </li>
    }
</ul>

@foreach (var member in Model.Members.Where(m => m.UserId != Model.CurrentUserId))
{
    <sc-sheet id="membre-@member.UserId" title="@(member.FullName ?? member.Phone)">
        <form method="post" asp-action="Update" asp-route-memberId="@member.UserId" class="grid gap-4">
            <div>
                <label class="sc-label" for="role-@member.UserId">@L["Team_RoleLabel"]</label>
                <select id="role-@member.UserId" name="role" class="sc-input">
                    @foreach (var role in roles)
                    {
                        <option value="@role" selected="@(role == member.Role)">@L["Role_" + role]</option>
                    }
                </select>
            </div>
            <fieldset>
                <legend class="sc-label">@L["Team_Sites"]</legend>
                <p class="sc-aide">@L["Team_Sites_Hint"]</p>
                <div class="mt-2 grid gap-1.5">
                    @foreach (var site in Model.Sites)
                    {
                        <label class="sc-choix"><input type="checkbox" name="sites" value="@site.Id" checked="@member.SiteIds.Contains(site.Id)" />@site.Name</label>
                    }
                </div>
            </fieldset>
            <button type="submit" class="sc-btn-primaire">@L["Common_Save"]</button>
        </form>
        <form method="post" asp-action="Remove" asp-route-memberId="@member.UserId" class="mt-3 border-t border-ligne pt-3">
            <button type="submit" class="sc-btn-danger w-full">@L["Team_Remove"]</button>
        </form>
    </sc-sheet>
}

<section class="mt-8 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-ligne bg-surface px-4 py-3" aria-labelledby="validation-titre">
    <div class="min-w-0">
        <h2 id="validation-titre" class="text-sm font-semibold">@L["Team_ApprovalTitle"]</h2>
        <p class="mt-0.5 max-w-prose text-[13px] text-charbon-doux">@L["Team_ApprovalText"]</p>
    </div>
    <form method="post" asp-action="Approval" class="flex items-center gap-3">
        <input type="hidden" name="required" value="@(!Model.RequiresApproval ? "true" : "false")" />
        <span class="sc-badge @(Model.RequiresApproval ? "bg-baobab-clair text-baobab" : "bg-sourdine text-charbon-doux")">@(Model.RequiresApproval ? L["Team_ApprovalIsOn"] : L["Team_ApprovalIsOff"])</span>
        <button type="submit" class="sc-btn-secondaire">@(Model.RequiresApproval ? L["Team_ApprovalDisable"] : L["Team_ApprovalEnable"])</button>
    </form>
</section>

<section id="inviter" class="mt-8 scroll-mt-20 rounded-lg border border-ligne bg-surface" aria-labelledby="invite-title">
    <div class="border-b border-ligne px-4 py-3">
        <h2 id="invite-title" class="text-sm font-semibold">@L["Team_InviteHeading"]</h2>
        <p class="mt-0.5 text-[13px] text-charbon-doux">@L["Team_InviteIntro"]</p>
    </div>
    <form method="post" asp-action="Index" class="grid gap-4 p-4 md:grid-cols-2" novalidate>
        <partial name="Ui/_PhoneInput" model="invitePhone" />
        <div>
            <label class="sc-label" asp-for="Invite.Role">@L["Team_RoleLabel"]</label>
            <select asp-for="Invite.Role" class="sc-input">
                @foreach (var role in roles)
                {
                    <option value="@role">@L["Role_" + role]</option>
                }
            </select>
        </div>
        @if (Model.Sites.Count > 0)
        {
            <fieldset class="md:col-span-2">
                <legend class="sc-label">@L["Team_Sites"]</legend>
                <p class="sc-aide">@L["Team_Sites_Hint"]</p>
                <div class="mt-2 grid gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var site in Model.Sites)
                    {
                        <label class="sc-choix"><input type="checkbox" name="Invite.Sites" value="@site.Id" checked="@Model.Invite.Sites.Contains(site.Id)" />@site.Name</label>
                    }
                </div>
            </fieldset>
        }
        <div class="md:col-span-2">
            <button type="submit" class="sc-btn-primaire">@L["Team_InviteSubmit"]</button>
        </div>
    </form>
</section>
