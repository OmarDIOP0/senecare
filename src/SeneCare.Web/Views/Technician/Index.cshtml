@model IReadOnlyList<SeneCare.Application.Technicians.MissionCard>
@using SeneCare.Application.Technicians
@using SeneCare.Domain.Common
@{
    Layout = "_AppLayout";
    ViewData["NavActive"] = "espace";
    ViewData["Title"] = L["Tech_Missions_Title"];
    var tourJson = ViewData["TourJson"] as string;
    var open = Model.Count(m => !m.IsDone);
}
@section Scripts {
    <script src="~/js/technician.js" asp-append-version="true" defer></script>
}

@if (tourJson is not null)
{
    <script type="application/json" id="sc-tour">@Html.Raw(tourJson)</script>
    @Html.AntiForgeryToken()
}

<h1 class="sc-titre">@L["Tech_Missions_Title"]</h1>
<p class="mt-1 text-lg">@Formatting.ShortDate(DateTimeOffset.UtcNow) · @L["Tech_Missions_Count", open]</p>

@if (Model.Count == 0)
{
    <div class="mt-6">
        <partial name="Ui/_EmptyState" model='new EmptyStateModel(L["Tech_None_Title"], L["Tech_None_Text"], EmptyIllustration.Tools)' />
    </div>
}

<ol class="mt-5 grid gap-4" data-missions data-tour="missions">
    @foreach (var m in Model)
    {
        var url = m.Kind == MissionKind.Diagnostic ? $"/technicien/diagnostics/{m.Id}" : $"/technicien/missions/{m.Id}";
        <li class="sc-carte relative @(m.Urgency == Urgency.Critical && !m.IsDone ? "border-rouge/40" : "") @(m.IsDone ? "opacity-70" : "")" data-mission
            data-rank="@((int)m.Urgency)" data-done="@(m.IsDone ? 1 : 0)"
            data-lat="@m.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
            data-lng="@m.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <div class="flex items-start gap-3">
                <span class="grid size-12 shrink-0 place-items-center rounded-md bg-ocre-clair text-charbon">
                    <sc-icon name="@(m.Domain is { } d ? Formatting.Icon(d) : "list-checks")" class="size-6" />
                </span>
                <div class="min-w-0 flex-1">
                    <p class="text-sm text-charbon-doux">
                        @(m.Kind == MissionKind.Diagnostic ? L["Tech_Diagnostic"] : L["Domain_" + m.Domain]) · @m.Number
                        <span class="ml-1 font-normal" data-distance hidden></span>
                    </p>
                    <h2 class="text-base font-semibold">
                        <a href="@url" class="text-charbon no-underline after:absolute after:inset-0" data-prefetch>@m.Title</a>
                    </h2>
                    <p class="mt-1 font-semibold">@m.Site <span class="font-normal text-charbon-doux">· @m.Place</span></p>
                    @if (m.Landmark is { } landmark)
                    {
                        <p class="mt-1 flex items-start gap-1.5 text-sm text-charbon-doux"><sc-icon name="map-pin" class="mt-0.5 size-4 shrink-0" />@landmark</p>
                    }
                    <p class="mt-2 flex flex-wrap gap-2">
                        @if (m.Kind == MissionKind.Intervention)
                        {
                            <sc-urgency value="@m.Urgency" />
                            <sc-status value="@m.Status!.Value" />
                        }
                        else
                        {
                            <span class="sc-badge bg-atlantique-clair text-atlantique">@L["DiagnosticStatus_" + m.DiagnosticStatus]</span>
                        }
                        @if (m.At is { } at)
                        {
                            <span class="sc-badge bg-sourdine text-charbon-doux"><sc-icon name="clock" class="size-3.5" />@Formatting.ShortDateTime(at)</span>
                        }
                    </p>
                </div>
            </div>
        </li>
    }
</ol>
