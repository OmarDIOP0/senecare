@model IReadOnlyList<Guid>
@if (Model.Count > 0)
{
    <div class="mt-2 flex gap-2 overflow-x-auto">
        @foreach (var photo in Model)
        {
            <img src="/fichiers/@photo" alt="" loading="lazy" decoding="async" class="size-20 shrink-0 rounded-md object-cover" />
        }
    </div>
}
