<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (SmarterASP.NET). Completed at publish by the SDK (process path, environment). No secret here: they are
  in appsettings.Server.json (not in git). If the test site fails to start, the reason is shown on the page
  (StartupErrorPage, Staging only). The stdout log stays off: it grows at every restart.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\SeneCare.Web.exe" arguments="" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
