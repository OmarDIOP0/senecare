<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (SmarterASP.NET). Completed at publish by the SDK (process path, environment). No secret here: they are
  in appsettings.Server.json (not in git). stdout log on: if the app fails to start (« HTTP Error 500.30 »), the reason
  is in logs\stdout_*.log (the site must be allowed to write: panel › VS Webdeploy › Fix ACL).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\SeneCare.Web.exe" arguments="" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
